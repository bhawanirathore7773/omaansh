<%- include('partials/header') %>
<main>
  <section class="hero hero-home">
    <div class="hero-copy">
      <span class="eyebrow">OSIRA · JAIPUR · WALL CLOCKS</span>
      <h1>Wall Clock Manufacturer in Jaipur for Bulk &amp; Custom Orders</h1>
      <p>Explore practical, decorative and promotional wall clocks from OSIRA. Choose a ready design or share your quantity, branding and delivery requirement for a current quotation.</p>
      <div class="actions">
        <a class="btn primary" href="/products">Browse wall clocks</a>
        <a class="btn secondary" href="#enquiry">Request a quotation</a>
      </div>
      <div class="trust-row"><span>Wholesale</span><span>Corporate gifting</span><span>Custom branding</span><span>Business supply</span></div>
    </div>
    <div class="hero-visual">
      <div class="clock-orbit orbit-a"></div><div class="clock-orbit orbit-b"></div>
      <div class="clock-face"><i></i><b></b><em>OSIRA</em><small>WALL CLOCKS</small></div>
      <button class="hero-note" type="button" data-open-enquiry><strong>Need a bulk order?</strong><span>Tell us the quantity, format and delivery city.</span><b>Open enquiry form ↗</b></button>
    </div>
  </section>


  <% if (banners && banners.length) { %>
  <section class="home-banner-section" aria-label="OSIRA featured banners">
    <div class="home-banner-carousel" data-carousel>
      <div class="home-banner-track">
        <% banners.forEach((banner, index) => { %>
        <article class="home-banner-slide <%= index === 0 ? 'is-active' : '' %>" data-slide="<%= index %>" aria-hidden="<%= index === 0 ? 'false' : 'true' %>" style="--banner-bg:<%= banner.backgroundColor || '#f7f5ef' %>">
          <% if (banner.linkUrl) { %><a class="home-banner-image-link" href="<%= banner.linkUrl %>" tabindex="<%= index === 0 ? '0' : '-1' %>" aria-label="Open banner <%= index + 1 %>"><% } %>
          <picture class="home-banner-picture">
            <% if (banner.mobileImage) { %><source media="(max-width: 700px)" srcset="<%= banner.mobileImage %>"><% } %>
            <img src="<%= banner.desktopImage || banner.mobileImage || ('/images/home-banner-' + (index + 1) + '.svg') %>" alt="OSIRA wall clock banner <%= index + 1 %>" <%= index === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %> width="1600" height="1200">
          </picture>
          <% if (banner.linkUrl) { %></a><% } %>
        </article>
        <% }) %>
      </div>
      <% if (banners.length > 1) { %>
      <button class="home-banner-arrow prev" type="button" aria-label="Previous banner" data-prev>‹</button>
      <button class="home-banner-arrow next" type="button" aria-label="Next banner" data-next>›</button>
      <div class="home-banner-dots" aria-label="Choose banner">
        <% banners.forEach((banner, index) => { %><button type="button" data-dot="<%= index %>" class="<%= index === 0 ? 'is-active' : '' %>" aria-label="Go to banner <%= index + 1 %>" aria-current="<%= index === 0 ? 'true' : 'false' %>"></button><% }) %>
      </div>
      <% } %>
    </div>
  </section>
  <script>
  (() => {
    const root = document.querySelector('[data-carousel]');
    if (!root) return;
    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    if (slides.length < 2) return;
    let active = 0, timer, startX = 0;
    const show = index => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === active);
        slide.setAttribute('aria-hidden', i === active ? 'false' : 'true');
        const link = slide.querySelector('a');
        if (link) link.tabIndex = i === active ? 0 : -1;
      });
      dots.forEach((dot, i) => { dot.classList.toggle('is-active', i === active); dot.setAttribute('aria-current', i === active ? 'true' : 'false'); });
    };
    const stop = () => window.clearInterval(timer);
    const start = () => { stop(); if (!document.hidden) timer = window.setInterval(() => show(active + 1), 5000); };
    root.querySelector('[data-prev]')?.addEventListener('click', () => { show(active - 1); start(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { show(active + 1); start(); });
    dots.forEach(dot => dot.addEventListener('click', () => { show(Number(dot.dataset.dot)); start(); }));
    root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop); root.addEventListener('focusout', start);
    root.addEventListener('touchstart', event => { startX = event.changedTouches[0].clientX; stop(); }, {passive:true});
    root.addEventListener('touchend', event => { const delta = event.changedTouches[0].clientX - startX; if (Math.abs(delta) > 45) show(active + (delta < 0 ? 1 : -1)); start(); }, {passive:true});
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
    start();
  })();
  </script>
  <% } %>

  <section class="section intro-strip">
    <div><span class="kicker">WALL CLOCK MANUFACTURER IN JAIPUR</span><h2>A focused catalogue for real buying decisions.</h2></div>
    <p>From everyday plastic wall clocks to promotional and custom business programmes, OSIRA keeps product information, quantity requirements and enquiries in one place.</p>
  </section>

  <section class="section" id="collections">
    <div class="section-head"><div><span class="kicker">SHOP BY REQUIREMENT</span><h2>Find the right wall clock collection.</h2></div><a href="/categories">View collections →</a></div>
    <div class="category-grid">
      <% const categoryPhotos = [
        'https://images.unsplash.com/photo-1563861826100-9cb868fdbe1c?auto=format&fit=crop&w=900&q=82',
        'https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=900&q=82',
        'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=900&q=82',
        'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=900&q=82',
        'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=900&q=82',
        'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=900&q=82',
        'https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=900&q=82',
        'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=900&q=82'
      ]; %>
      <% categories.slice(0,8).forEach((category, index) => { %>
        <a class="category-card category-card-visual" href="/categories/<%= category.slug %>" style="--category-image:url('<%= category.image || categoryPhotos[index % categoryPhotos.length] %>')">
          <img src="<%= category.image || categoryPhotos[index % categoryPhotos.length] %>" alt="<%= category.name %>" loading="lazy" width="700" height="500">
          <span class="card-index"><%= String(category.displayOrder).padStart(2,'0') %></span>
          <div class="category-card-copy"><strong><%= category.name %></strong><span><%= category.description %></span><b>Explore collection <i>↗</i></b></div>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="section feature-section">
    <div class="section-head"><div><span class="kicker">FEATURED WALL CLOCKS</span><h2>Popular formats to start with.</h2></div><a href="/products">See full catalogue →</a></div>
    <div class="product-grid">
      <% featuredProducts.forEach(product => { %>
        <a class="product-card" href="/products/<%= product.slug %>">
          <div class="product-media">
            <% if (product.image) { %><img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" width="800" height="600"><% } else { %><img src="https://images.unsplash.com/photo-1563861826100-9cb868fdbe1c?auto=format&fit=crop&w=900&q=82" alt="Wall clock product image" loading="lazy" width="800" height="600"><% } %>
            <% if(product.isFeatured){ %><span class="product-status-badge featured">Featured</span><% } else if(product.isNewArrival){ %><span class="product-status-badge new">New arrival</span><% } else if(product.isBestseller){ %><span class="product-status-badge bestseller">Bestseller</span><% } %><span class="product-image-label">OSIRA · WALL CLOCKS</span>
          </div>
          <div class="product-body"><span class="product-category-label"><%= product.category?.name || 'Wall Clock' %></span><h2><%= product.name %></h2>
            <ul class="product-quick-specs">
              <% if (product.size) { %><li><span>Size</span><b><%= product.size %></b></li><% } %>
              <% if (product.shape) { %><li><span>Shape</span><b><%= product.shape %></b></li><% } %>
              <% if (product.material) { %><li><span>Material</span><b><%= product.material %></b></li><% } %>
            </ul>
            <div class="product-card-bottom"><strong><%= product.price ? 'From ₹' + Number(product.price).toLocaleString('en-IN') : 'Request current price' %></strong><span class="product-explore">View details ↗</span></div>
          </div>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="section dark business-section">
    <div class="section-head"><div><span class="kicker">BUSINESS SOLUTIONS</span><h2>One supplier for different order requirements.</h2><p>Start with the application, quantity and product direction. We can then discuss the most suitable current option.</p></div></div>
    <div class="business-grid business-grid-visual">
      <a class="business-visual-card" href="/services/wholesale-wall-clocks" style="--business-image:url('https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1100&q=82')"><img src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1100&q=82" alt="Wholesale supply for retail and offices" loading="lazy"><div><b>01 / BUSINESS SUPPLY</b><h3>Wholesale & retail supply</h3><p>Build a practical wall clock assortment for retail, dealers and distribution.</p><span>Explore wholesale ↗</span></div></a>
      <a class="business-visual-card" href="/services/corporate-gifting" style="--business-image:url('https://images.unsplash.com/photo-1513201099705-a9746e1e201f?auto=format&fit=crop&w=1100&q=82')"><img src="https://images.unsplash.com/photo-1513201099705-a9746e1e201f?auto=format&fit=crop&w=1100&q=82" alt="Corporate gifting presentation" loading="lazy"><div><b>02 / GIFTING</b><h3>Corporate gifting</h3><p>Explore useful gifting formats for employees, dealers and institutions.</p><span>Explore gifting ↗</span></div></a>
      <a class="business-visual-card" href="/services/promotional-wall-clocks" style="--business-image:url('https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=1100&q=82')"><img src="https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=1100&q=82" alt="Promotional branding materials" loading="lazy"><div><b>03 / BRANDING</b><h3>Promotional branding</h3><p>Discuss artwork, quantities and packaging for campaign requirements.</p><span>Explore promotional ↗</span></div></a>
      <a class="business-visual-card" href="/services/custom-oem-wall-clocks" style="--business-image:url('https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1100&q=82')"><img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1100&q=82" alt="Custom interior and OEM inspiration" loading="lazy"><div><b>04 / CUSTOM & OEM</b><h3>Custom & OEM</h3><p>Discuss formats, dimensions, colours and business quantities.</p><span>Explore custom ↗</span></div></a>
    </div>
  </section>

  <% (homeProductSections || []).forEach(section => { const sectionProducts = (section.products || []).map(item => item.product).filter(product => product && product.isActive); if (sectionProducts.length) { %>
  <section class="section home-merchandising-section" id="home-section-<%= section.slug %>">
    <div class="section-head">
      <div>
        <% if (section.eyebrow) { %><span class="kicker"><%= section.eyebrow %></span><% } %>
        <h2><%= section.title %></h2>
        <% if (section.description) { %><p><%= section.description %></p><% } %>
      </div>
      <a class="home-section-see-all" href="/products?section=<%= encodeURIComponent(section.slug) %>">See all <span aria-hidden="true">→</span></a>
    </div>
    <div class="product-grid home-section-product-grid">
      <% sectionProducts.slice(0, 6).forEach(product => { %>
      <a class="product-card" href="/products/<%= product.slug %>">
        <div class="product-media">
          <% if (product.image) { %><img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" width="800" height="800"><% } else { %><div class="placeholder">OSIRA</div><% } %>
          <% if (product.isNewArrival) { %><span class="product-status-badge new">New arrival</span><% } else if (product.isBestseller) { %><span class="product-status-badge bestseller">Bestseller</span><% } else if (product.isFeatured) { %><span class="product-status-badge featured">Featured</span><% } %>
          <span class="product-image-label">OSIRA · WALL CLOCKS</span>
        </div>
        <div class="product-body">
          <span class="product-category-label"><%= product.category?.name || 'Wall Clocks' %></span>
          <h3><%= product.name %></h3>
          <div class="product-card-bottom"><strong><%= product.price ? 'From ₹' + Number(product.price).toLocaleString('en-IN') : 'Request current price' %></strong><span class="product-explore">View details ↗</span></div>
        </div>
      </a>
      <% }) %>
    </div>
    <% if (sectionProducts.length > 6) { %><div class="home-section-mobile-all"><a href="/products?section=<%= encodeURIComponent(section.slug) %>">Explore all <%= sectionProducts.length %> products →</a></div><% } %>
  </section>
  <% } }) %>

  <section class="section seo-home">
    <div class="seo-home-grid">
      <div><span class="kicker">WHY OSIRA</span><h2>Built around the way businesses actually buy wall clocks.</h2></div>
      <div class="rich-copy">
        <p>OSIRA is a Jaipur-based wall clock brand serving product enquiries for homes, offices, retailers, institutions and business programmes. The catalogue covers practical and decorative formats alongside promotional and custom requirements.</p>
        <p>For wholesale or branded orders, product suitability depends on the required size, shape, finish, quantity, artwork, packaging and delivery destination. Instead of publishing unsupported promises, OSIRA uses a requirement-led enquiry process so the current commercial details can be confirmed before an order is approved.</p>
      </div>
    </div>
  </section>

  <section class="section enquiry" id="enquiry">
    <div><span class="kicker">START A QUOTATION</span><h2>Tell us what you need.</h2><p>Include approximate quantity, preferred size or style, branding requirements and delivery city.</p>
      <% if (enquirySent) { %><div class="form-success">Thank you. Your requirement has been received. Our team will get back to you.</div><% } %>
    </div>
    <form class="enquiry-form" method="post" action="/enquiries">
      <input type="text" name="name" placeholder="Your name" autocomplete="name" required>
      <input type="tel" name="phone" placeholder="Phone number" autocomplete="tel" required>
      <input type="email" name="email" placeholder="Email (optional)" autocomplete="email">
      <input type="text" name="city" placeholder="Delivery city" autocomplete="address-level2" required>
      <textarea name="message" rows="5" placeholder="Quantity, size, style, branding or other requirement" required></textarea>
      <input class="honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn primary" type="submit">Send requirement →</button>
    </form>
  </section>
</main>
<%- include('partials/footer', { site }) %>
