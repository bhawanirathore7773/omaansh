<%- include('partials/header') %>
<main class="solution-detail solution-detail-v3">
<section class="section solution-detail-hero solution-detail-hero-v3"><div class="breadcrumbs"><a href="/industries">Industries</a><span>›</span><%= industry.industryName %></div>
<div class="solution-detail-layout-v3"><div class="solution-detail-copy"><span class="kicker">INDUSTRY SOLUTION · OSIRA</span><h1><%= industry.h1Heading %></h1><p><%= industry.heroSubheading %></p><div class="actions"><a class="btn primary" href="/#enquiry">Discuss your requirement</a><a class="btn secondary" href="/products">Browse wall clocks</a></div><div class="solution-proof-pills"><span>Product-led guidance</span><span>Wholesale enquiries</span><span>Business order support</span></div></div>
<div class="solution-detail-visual"><img src="<%= industry.heroImage || 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1400&q=85' %>" alt="<%= industry.industryName %> wall clock application" width="1200" height="900" fetchpriority="high"><div class="solution-visual-note"><strong>Planned around your application</strong><span>Confirm product style, quantity, branding and delivery needs.</span></div></div></div></section>
<section class="section solution-content solution-content-v3"><article><span class="kicker">OVERVIEW</span><div class="rich-copy"><%- industry.introContent %></div></article><% if(industry.benefitsContent){ %><article><span class="kicker">BENEFITS</span><div class="rich-copy"><%- industry.benefitsContent %></div></article><% } %><% if(industry.customizationContent){ %><article><span class="kicker">CUSTOMIZATION</span><div class="rich-copy"><%- industry.customizationContent %></div></article><% } %><% if(industry.caseStudyContent){ %><article><span class="kicker">USE CASE</span><div class="rich-copy"><%- industry.caseStudyContent %></div></article><% } %></section>
<% if (industry.featuredProducts.length) { %><section class="section"><div class="section-head"><div><span class="kicker">RECOMMENDED PRODUCTS</span><h2>Products for this application</h2></div><a href="/products">View catalogue →</a></div><div class="product-grid"><% industry.featuredProducts.forEach(item=>{ const product=item.product; %><a class="product-card" href="/products/<%= product.slug %>"><div class="product-media"><% if(product.image){ %><img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" width="800" height="600"><% }else{ %><div class="placeholder">OSIRA</div><% } %></div><div class="product-body"><span><%= product.category?.name || "Wall Clock" %></span><h2><%= product.name %></h2><strong><%= product.price ? "From ₹"+Number(product.price).toLocaleString("en-IN") : "Request current price" %></strong></div></a><% }) %></div></section><% } %>
<section class="section solution-cta"><div><span class="kicker">READY TO SOURCE?</span><h2>Tell OSIRA what the space requires.</h2></div><a class="btn primary" href="/#enquiry">Start an enquiry →</a></section></main><%- include('partials/footer',{site}) %>