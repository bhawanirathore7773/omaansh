<%- include('partials/header') %>
<main class="guides-page">
<section class="section guides-hero"><span class="kicker">OSIRA GUIDES</span><h1>Wall clock buying guides for better product and business decisions.</h1><p>Practical resources covering sizes, office selection, promotional branding, plastic clock buying and wholesale sourcing. Start with the guide closest to your requirement.</p></section>
<section class="section guides-grid-section"><div class="guides-index"><span class="kicker">BUYING RESOURCES</span><span><%= posts.length %> guides</span></div><div class="blog-grid blog-grid-v2"><% posts.forEach((post,i)=>{ %><a class="blog-card blog-card-v2" href="/blog/<%= post.slug %>"><span class="guide-number"><%= String(i+1).padStart(2,'0') %></span><span><%= post.category %></span><h2><%= post.title %></h2><p><%= post.description %></p><strong>Read guide →</strong></a><% }) %></div></section>
<section class="section guide-cta"><div><span class="kicker">NEED A PRODUCT NOW?</span><h2>Use the catalogue for current product information.</h2></div><a class="btn primary" href="/products">Browse wall clocks →</a></section>
</main><%- include('partials/footer',{site}) %>