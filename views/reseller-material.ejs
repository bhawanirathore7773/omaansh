<%- include('partials/header') %>
<main class="reseller-page">
<% if (!material) { %>
  <section class="section reseller-not-found"><span class="reseller-eyebrow">COMPONENT GUIDE</span><h1>This component is not currently listed.</h1><p>Browse the component library or contact OSIRA for current options.</p><a class="reseller-btn reseller-btn-primary" href="/reseller">Back to reseller guide</a></section>
<% } else { const gallery = Array.isArray(material.gallery) ? material.gallery : []; const sizes = Array.isArray(material.sizes) ? material.sizes : []; const colors = Array.isArray(material.colors) ? material.colors : []; const styles = Array.isArray(material.styles) ? material.styles : []; const movementTypes = Array.isArray(material.movementTypes) ? material.movementTypes : []; const specs = Array.isArray(material.specifications) ? material.specifications : []; const qualityPoints = Array.isArray(material.qualityPoints) ? material.qualityPoints : []; const whatsappText = (settings.whatsappIntro || 'Hello OSIRA, please share reseller component details.') + '\nComponent: ' + material.name + '\nPlease confirm current availability, MOQ, pricing and exact specifications.'; %>
  <section class="section reseller-detail-hero">
    <div><a class="reseller-back-link" href="/reseller">← All reseller components</a><span class="reseller-eyebrow"><%= material.componentType %></span><h1><%= material.name %></h1><p class="reseller-detail-short"><%= material.shortDescription %></p><p><%= material.description %></p><div class="reseller-hero-actions"><a class="reseller-btn reseller-btn-primary" href="https://wa.me/<%= (site?.whatsappNumber || '919509912556').replace(/[^0-9]/g,'') %>?text=<%= encodeURIComponent(whatsappText) %>" target="_blank" rel="noopener noreferrer">Ask about this component <span aria-hidden="true">↗</span></a><a class="reseller-btn" href="/reseller">Explore other components</a></div></div>
    <div class="reseller-product-gallery" data-product-gallery>
      <div class="reseller-detail-image" data-gallery-stage tabindex="0" role="region" aria-label="Product images. Swipe left or right to change image.">
        <img data-gallery-main src="<%= material.image || (gallery[0] || 'https://images.unsplash.com/photo-1563861826100-9cb868fdbe1c?auto=format&fit=crop&w=1200&q=82') %>" alt="<%= material.name %>" width="900" height="675" fetchpriority="high">
        <button class="reseller-gallery-arrow reseller-gallery-prev" type="button" data-gallery-prev aria-label="Previous image">‹</button>
        <button class="reseller-gallery-arrow reseller-gallery-next" type="button" data-gallery-next aria-label="Next image">›</button>
        <span class="reseller-gallery-count" data-gallery-count>1 / 1</span>
      </div>
      <div class="reseller-gallery-thumbnails" data-gallery-thumbnails aria-label="Choose product image"></div>
      <div class="reseller-gallery-progress" data-gallery-progress aria-label="Current image"></div>
      <script type="application/json" data-gallery-images><%- JSON.stringify([material.image, ...gallery].filter((image,index,all)=>typeof image==='string' && image.trim() && all.indexOf(image)===index)) %></script>
    </div>
  </section>
  <section class="section reseller-detail-content">
    <div class="reseller-detail-panel"><h2>Specifications to confirm</h2>
      <% if (specs.length) { %><table class="reseller-spec-table"><tbody><% specs.forEach(spec=>{ %><tr><th><%= spec.key || 'Specification' %></th><td><%= spec.value || 'Confirm for selected model' %></td></tr><% }) %></tbody></table><% } else { %><p>Confirm exact dimensions, material grade, fitment and availability with the OSIRA team.</p><% } %>
      <div class="reseller-note"><strong>Important:</strong> Specifications shown are a guide. Confirm the exact model, material, dimensions and commercial terms before ordering.</div>
    </div>
    <aside class="reseller-detail-panel"><h2>Options in the guide</h2>
      <% if(sizes.length){ %><h3>Sizes / fitment</h3><div class="reseller-tag-list"><% sizes.forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }) %></div><% } %>
      <% if(colors.length){ %><h3>Colours</h3><div class="reseller-tag-list"><% colors.forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }) %></div><% } %>
      <% if(styles.length){ %><h3>Styles / finishes</h3><div class="reseller-tag-list"><% styles.forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }) %></div><% } %>
      <% if(movementTypes.length){ %><h3>Movement types</h3><div class="reseller-tag-list"><% movementTypes.forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }) %></div><% } %>
      <% if(qualityPoints.length){ %><h3>Quality checks</h3><ul class="reseller-detail-list"><% qualityPoints.forEach(x=>{ %><li><%= x %></li><% }) %></ul><% } %>
      <% if(material.orderingNotes){ %><div class="reseller-note"><%= material.orderingNotes %></div><% } %>
      <a class="reseller-btn reseller-btn-primary reseller-full-btn" href="https://wa.me/<%= (site?.whatsappNumber || '919509912556').replace(/[^0-9]/g,'') %>?text=<%= encodeURIComponent(whatsappText) %>" target="_blank" rel="noopener noreferrer">Get current wholesale details ↗</a>
    </aside>
  </section>
<% } %>
</main>
<script>
(() => {
 const root=document.querySelector('[data-product-gallery]');
 if(!root)return;
 const data=root.querySelector('[data-gallery-images]');
 const main=root.querySelector('[data-gallery-main]');
 const stage=root.querySelector('[data-gallery-stage]');
 const thumbs=root.querySelector('[data-gallery-thumbnails]');
 const progress=root.querySelector('[data-gallery-progress]');
 const count=root.querySelector('[data-gallery-count]');
 let images=[];
 try { images=JSON.parse(data?.textContent||'[]').filter(x=>typeof x==='string'&&x.trim()); } catch {}
 if(!images.length&&main?.src)images=[main.src];
 let active=0,startX=0,startY=0;
 const render=(next,focusThumb=false)=>{
   if(!images.length||!main)return;
   active=(next+images.length)%images.length;
   main.src=images[active];
   main.alt='<%= material.name.replace(/'/g, '&#39;') %> — image '+(active+1);
   count.textContent=(active+1)+' / '+images.length;
   [...thumbs.children].forEach((button,i)=>{button.classList.toggle('is-active',i===active);button.setAttribute('aria-current',i===active?'true':'false');});
   [...progress.children].forEach((dot,i)=>{dot.classList.toggle('is-active',i===active);});
   if(focusThumb)thumbs.children[active]?.scrollIntoView({block:'nearest',inline:'nearest',behavior:'smooth'});
 };
 images.forEach((src,i)=>{
   const button=document.createElement('button');
   button.type='button';button.className='reseller-gallery-thumb';button.setAttribute('aria-label','Show image '+(i+1));
   const image=document.createElement('img');image.src=src;image.alt='';image.loading=i>3?'lazy':'eager';button.appendChild(image);
   button.addEventListener('click',()=>render(i));thumbs.appendChild(button);
   const dot=document.createElement('button');dot.type='button';dot.className='reseller-gallery-dot';dot.setAttribute('aria-label','Show image '+(i+1));dot.addEventListener('click',()=>render(i,true));progress.appendChild(dot);
 });
 root.querySelector('[data-gallery-prev]')?.addEventListener('click',()=>render(active-1,true));
 root.querySelector('[data-gallery-next]')?.addEventListener('click',()=>render(active+1,true));
 stage?.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'){e.preventDefault();render(active-1,true)}else if(e.key==='ArrowRight'){e.preventDefault();render(active+1,true)}});
 stage?.addEventListener('touchstart',e=>{const t=e.changedTouches[0];startX=t.clientX;startY=t.clientY;},{passive:true});
 stage?.addEventListener('touchend',e=>{const t=e.changedTouches[0];const dx=t.clientX-startX,dy=t.clientY-startY;if(Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy)*1.15)render(active+(dx<0?1:-1),true);},{passive:true});
 stage?.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'){startX=e.clientX;startY=e.clientY;}});
 stage?.addEventListener('pointerup',e=>{if(e.pointerType==='mouse'){const dx=e.clientX-startX,dy=e.clientY-startY;if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)*1.15)render(active+(dx<0?1:-1),true);}});
 if(images.length<=1){root.classList.add('is-single-image');}
 render(0);
})();
</script>
<%- include('partials/footer', { site }) %>