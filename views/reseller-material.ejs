<%- include('partials/header') %>
<main class="reseller-page">
<% if (!material) { %>
  <section class="section reseller-not-found"><span class="reseller-eyebrow">COMPONENT GUIDE</span><h1>This component is not currently listed.</h1><p>Browse the component library or contact OSIRA for current options.</p><a class="reseller-btn reseller-btn-primary" href="/reseller">Back to reseller guide</a></section>
<% } else { const gallery = Array.isArray(material.gallery) ? material.gallery : []; const sizes = Array.isArray(material.sizes) ? material.sizes : []; const colors = Array.isArray(material.colors) ? material.colors : []; const styles = Array.isArray(material.styles) ? material.styles : []; const movementTypes = Array.isArray(material.movementTypes) ? material.movementTypes : []; const specs = Array.isArray(material.specifications) ? material.specifications : []; const qualityPoints = Array.isArray(material.qualityPoints) ? material.qualityPoints : []; const whatsappText = (settings.whatsappIntro || 'Hello OSIRA, please share reseller component details.') + '\nComponent: ' + material.name + '\nPlease confirm current availability, MOQ, pricing and exact specifications.'; %>
  <section class="section reseller-detail-hero">
    <div><a class="reseller-back-link" href="/reseller">← All reseller components</a><span class="reseller-eyebrow"><%= material.componentType %></span><% if(material.isFeatured){ %><span class="reseller-badge reseller-badge-featured reseller-detail-badge">✦ FEATURED</span><% } else if(material.isRecommended){ %><span class="reseller-badge reseller-badge-recommended reseller-detail-badge">✓ RECOMMENDED</span><% } %><h1><%= material.name %></h1><p class="reseller-detail-short"><%= material.shortDescription %></p><p><%= material.description %></p><div class="reseller-hero-actions"><a class="reseller-btn reseller-btn-primary" href="https://wa.me/<%= (site?.whatsappNumber || '919509912556').replace(/[^0-9]/g,'') %>?text=<%= encodeURIComponent(whatsappText) %>" target="_blank" rel="noopener noreferrer">Ask about this component <span aria-hidden="true">↗</span></a><a class="reseller-btn" href="/reseller">Explore other components</a></div></div>
    <div class="reseller-detail-image"><img src="<%= material.image || (gallery[0] || 'https://images.unsplash.com/photo-1563861826100-9cb868fdbe1c?auto=format&fit=crop&w=1200&q=82') %>" alt="<%= material.name %>" width="900" height="675" fetchpriority="high"></div>
  </section>
  <% if (gallery.length) { %><section class="section"><div class="reseller-gallery"><% gallery.forEach((image,index)=>{ %><img src="<%= image %>" alt="<%= material.name %> detail view <%= index+1 %>" loading="lazy" width="400" height="400"><% }) %></div></section><% } %>
  <section class="section reseller-detail-content">
    <div class="reseller-detail-panel"><h2>Specifications to confirm</h2>
      <% if (specs.length) { %><table class="reseller-spec-table"><tbody><% specs.forEach(spec=>{ %><tr><th><%= spec.key || 'Specification' %></th><td><%= spec.value || 'Confirm for selected model' %></td></tr><% }) %></tbody></table><% } else { %><p>Confirm exact dimensions, material grade, fitment and availability with the OSIRA team.</p><% } %>
      <div class="reseller-note"><strong>Important:</strong> Specifications shown are a guide. Confirm the exact model, material, dimensions and commercial terms before ordering.</div>
    </div>
    <aside class="reseller-detail-panel"><h2>Options in the guide</h2>
      <% if(sizes.length){ %><h3>Sizes / fitment</h3><div class="reseller-tag-list"><% sizes.forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }) %></div><% } %>
      <% if(colors.length){ %><h3>Colours</h3><div class="reseller-tag-list"><% colors.forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }) %></div><% } %>
      <% if(styles.length){ %><h3>Styles / finishes</h3><div class="reseller-tag-list"><% styles.forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }) %></div><% } %>
      <% if(movementTypes.length){ %><h3>Movement types</h3><div class="reseller-tag-list"><% movementTypes.forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }) %></div><% } %>
      <% if(qualityPoints.length){ %><h3>Quality checks</h3><ul class="reseller-detail-list"><% qualityPoints.forEach(x=>{ %><li><%= x %></li><% }) %></ul><% } %>
      <% if(material.orderingNotes){ %><div class="reseller-note"><%= material.orderingNotes %></div><% } %>
      <a class="reseller-btn reseller-btn-primary reseller-full-btn" href="https://wa.me/<%= (site?.whatsappNumber || '919509912556').replace(/[^0-9]/g,'') %>?text=<%= encodeURIComponent(whatsappText) %>" target="_blank" rel="noopener noreferrer">Get current wholesale details ↗</a>
    </aside>
  </section>
<% } %>
</main>
<%- include('partials/footer', { site }) %>