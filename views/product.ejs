<%- include('partials/header') %>
<main class="product-page">
  <div class="section product-breadcrumbs"><a href="/">Home</a><span>›</span><a href="/products">Wall Clocks</a><% if(product.category){ %><span>›</span><a href="/categories/<%= product.category.slug %>"><%= product.category.name %></a><% } %><span>›</span><strong><%= product.name %></strong></div>

  <section class="product-hero section">
    <div class="gallery">
      <% const imgs=[product.image,...(Array.isArray(product.additionalImages)?product.additionalImages:[])].filter(Boolean).slice(0,5); const mainProductImage=imgs[0]; %>
      <div class="main-image">
        <% if(mainProductImage){ %><img id="mainImage" src="<%= mainProductImage %>" alt="<%= product.name %> wall clock by OSIRA" width="1000" height="800"><% } else { %><div class="product-image-empty"><span>OSIRA</span><small>Product image coming soon</small></div><% } %>
      </div>
      <% if(imgs.length>1){ %>
      <div class="thumbs" aria-label="Product images">
        <% imgs.forEach((img,i)=>{ %><button type="button" class="thumb <%= i===0?'active':'' %>" data-gallery-image="<%= img %>" aria-label="View product image <%= i+1 %>" aria-pressed="<%= i===0?'true':'false' %>"><img src="<%= img %>" alt="<%= product.name %> view <%= i+1 %>" loading="lazy"></button><% }) %>
      </div><% } %>
    </div>

    <div class="product-info">
      <span class="kicker"><%= product.category?.name || 'Wall Clock' %></span>
      <h1><%= product.name %></h1>
      <p class="product-lead"><%= product.shortDescription || product.description %></p>
      <div class="product-meta-line"><% if(product.sku){ %><span>SKU <b><%= product.sku %></b></span><% } %><span><%= product.availability === 'InStock' ? 'Available for enquiry' : 'Made / supplied on request' %></span></div>
      <div class="price-block">
        <div class="price"><%= product.price ? '₹' + Number(product.price).toLocaleString('en-IN') : 'Current price on enquiry' %><% if(product.price){ %><small> / piece</small><% } %></div>
        <% if(product.bulkPrice && product.price && Number(product.bulkPrice)<Number(product.price)){ %><div class="product-offer-line"><strong>₹<%= Number(product.bulkPrice).toLocaleString('en-IN') %> bulk price</strong><span><%= Math.round((1-Number(product.bulkPrice)/Number(product.price))*100) %>% bulk saving</span></div><% } else if(product.bulkPrice && product.price){ %><div class="product-offer-line"><strong>Bulk price ₹<%= Number(product.bulkPrice).toLocaleString('en-IN') %></strong><span>For eligible quantities</span></div><% } %>
      </div>
      <p class="price-note">Final commercial pricing depends on order quantity, specifications, branding and delivery requirements. Confirm your quotation with OSIRA.</p>
      <div class="buybox"><span>Minimum order quantity</span><strong><%= product.moq %> pcs</strong><span class="buybox-note">Bulk and repeat orders welcome</span></div>
      <div class="actions"><a class="btn primary" href="#product-enquiry">Request product quotation →</a><a class="btn secondary" href="https://wa.me/<%= site?.whatsappNumber || '919509912556' %>?text=<%= encodeURIComponent('Hello OSIRA, I need a quotation for '+product.name+(product.sku?' (SKU '+product.sku+')':'')) %>" target="_blank" rel="noopener">WhatsApp</a></div>
    </div>
  </section>

  <section class="section product-details-grid">
    <article class="detail-panel"><span class="kicker">PRODUCT DETAILS</span><h2>Specifications</h2>
      <% if(product.specifications){ %><div class="spec-copy"><%= product.specifications %></div><% } else { %><p>Specification details are confirmed with the quotation based on the selected product and quantity.</p><% } %>
    </article>
    <article class="detail-panel"><span class="kicker">BUSINESS ORDERS</span><h2>What to include in your enquiry</h2>
      <ul class="check-list"><li>Required quantity and delivery city</li><li>Preferred size, finish or colour</li><li>Logo / branding requirement, if applicable</li><li>Packaging or campaign requirement</li></ul>
      <a class="text-link" href="/services/wholesale-wall-clocks">Explore wholesale supply →</a>
    </article>
  </section>

  <% if(product.pricingTierTemplate){ %>
  <section class="section pricing"><div class="section-head"><div><span class="kicker">QUANTITY PRICING</span><h2>Indicative quantity tiers</h2><p>These are starting calculations from the configured base price. Confirm the current commercial quote before ordering.</p></div></div>
    <div class="tier-grid"><%
      [[product.pricingTierTemplate.tier1MinQty,product.pricingTierTemplate.tier1MaxQty,product.pricingTierTemplate.tier1Label,product.pricingTierTemplate.tier1DiscountType,product.pricingTierTemplate.tier1DiscountValue],
       [product.pricingTierTemplate.tier2MinQty,product.pricingTierTemplate.tier2MaxQty,product.pricingTierTemplate.tier2Label,product.pricingTierTemplate.tier2DiscountType,product.pricingTierTemplate.tier2DiscountValue],
       [product.pricingTierTemplate.tier3MinQty,product.pricingTierTemplate.tier3MaxQty,product.pricingTierTemplate.tier3Label,product.pricingTierTemplate.tier3DiscountType,product.pricingTierTemplate.tier3DiscountValue],
       [product.pricingTierTemplate.tier4MinQty,product.pricingTierTemplate.tier4MaxQty,product.pricingTierTemplate.tier4Label,product.pricingTierTemplate.tier4DiscountType,product.pricingTierTemplate.tier4DiscountValue],
       [product.pricingTierTemplate.tier5MinQty,product.pricingTierTemplate.tier5MaxQty,product.pricingTierTemplate.tier5Label,product.pricingTierTemplate.tier5DiscountType,product.pricingTierTemplate.tier5DiscountValue]
      ].forEach(t=>{ %><div class="tier"><strong><%= t[0] %>–<%= t[1]>=99999?'+':t[1] %> pcs</strong><span><%= t[2] %></span><% if(Number(t[4])>0){ %><em class="tier-saving"><%= t[3]==='percent' ? Number(t[4])+'% bulk saving' : 'Bulk discount applied' %></em><% } %><b><%= product.price ? '₹'+Number(product.price*(1-(t[3]==='percent'?Number(t[4])/100:Number(t[4])/Number(product.price)))).toFixed(2) : 'Quote' %> / piece</b></div><% }) %>
    </div>
  </section><% } %>

  <section class="section product-enquiry" id="product-enquiry">
    <div><span class="kicker">REQUEST A QUOTATION</span><h2>Need this wall clock in quantity?</h2><p>Send your requirement directly with this product attached to the enquiry.</p></div>
    <form class="enquiry-form" method="post" action="/enquiries">
      <input type="hidden" name="productId" value="<%= product.id %>">
      <input type="hidden" name="website" value="">
      <input type="text" name="name" placeholder="Your name" autocomplete="name" required>
      <input type="tel" name="phone" placeholder="Phone number" autocomplete="tel" required>
      <input type="email" name="email" placeholder="Email (optional)" autocomplete="email">
      <input type="text" name="city" placeholder="Delivery city" autocomplete="address-level2" required>
      <textarea name="message" rows="5" required>Quotation required for <%= product.name %><%= product.sku ? ' (SKU '+product.sku+')' : '' %>. Quantity: </textarea>
      <button class="btn primary" type="submit">Send product enquiry →</button>
    </form>
  </section>

  <% if(related.length){ %><section class="section product-recommendations"><div class="section-head"><div><span class="kicker">BUYERS ALSO EXPLORE</span><h2>Similar wall clocks for your order</h2><p>Compare styles and specifications before finalising your bulk requirement.</p></div><a href="/products">View full catalogue →</a></div><div class="product-grid">
    <% related.forEach(p=>{ %><a class="product-card recommendation-card" href="/products/<%= p.slug %>"><div class="product-media"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" width="800" height="600"><% } else { %><div class="placeholder">OSIRA</div><% } %><% if(p.isBestseller){ %><span class="catalogue-badge">Bestseller</span><% } else if(p.isNewArrival){ %><span class="catalogue-badge new">New arrival</span><% } %></div><div class="product-body"><span><%= p.category?.name || 'Wall Clock' %></span><h2><%= p.name %></h2><% if(p.shortDescription){ %><p><%= p.shortDescription %></p><% } %><div class="catalogue-price-line"><strong><%= p.price ? '₹'+Number(p.price).toLocaleString('en-IN') : 'Price on enquiry' %></strong><% if(p.bulkPrice && p.price && Number(p.bulkPrice)<Number(p.price)){ %><span class="catalogue-discount"><%= Math.round((1-Number(p.bulkPrice)/Number(p.price))*100) %>% bulk saving</span><% } else if(p.bulkPrice || p.pricingTierTemplateId){ %><span class="catalogue-discount">Bulk pricing</span><% } %></div><span class="catalogue-card-link">View details <b>↗</b></span></div></a><% }) %>
  </div></section><% } %>
  <section class="section recently-viewed-section" id="recentlyViewedSection" hidden><div class="section-head"><div><span class="kicker">PICK UP WHERE YOU LEFT OFF</span><h2>Recently viewed wall clocks</h2><p>Your recent product views on this device.</p></div><a href="/products">Browse catalogue →</a></div><div class="product-grid" id="recentlyViewedGrid"></div></section>
  <script>
  (() => {
    const gallery=document.querySelector('.thumbs');
    const main=document.getElementById('mainImage');
    gallery?.querySelectorAll('[data-gallery-image]').forEach(button=>button.addEventListener('click',()=>{
      if(!main)return;main.src=button.dataset.galleryImage;
      gallery.querySelectorAll('.thumb').forEach(item=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-pressed',active?'true':'false');});
    }));
    const current={slug:<%- JSON.stringify(product.slug).replace(/</g,'\\u003c') %>,name:<%- JSON.stringify(product.name).replace(/</g,'\\u003c') %>,image:<%- JSON.stringify(product.image || '').replace(/</g,'\\u003c') %>,price:<%- JSON.stringify(product.price ? Number(product.price) : null) %>,category:<%- JSON.stringify(product.category?.name || 'Wall Clock').replace(/</g,'\\u003c') %>};
    let viewed=[];try{viewed=JSON.parse(localStorage.getItem('osiraRecentlyViewed')||'[]');if(!Array.isArray(viewed))viewed=[];}catch(_){viewed=[];}
    viewed=[current,...viewed.filter(item=>item.slug!==current.slug)].slice(0,7);
    try{localStorage.setItem('osiraRecentlyViewed',JSON.stringify(viewed));}catch(_){}
    const history=viewed.filter(item=>item.slug!==current.slug).slice(0,4);
    const section=document.getElementById('recentlyViewedSection'),grid=document.getElementById('recentlyViewedGrid');
    if(!history.length||!section||!grid)return;
    const money=value=>value?'₹'+Number(value).toLocaleString('en-IN'):'Price on enquiry';
    history.forEach(item=>{
      const a=document.createElement('a');a.className='product-card';a.href='/products/'+encodeURIComponent(item.slug);
      const media=document.createElement('div');media.className='product-media';
      if(item.image){const img=document.createElement('img');img.src=item.image;img.alt=item.name;img.loading='lazy';media.appendChild(img);}else{const ph=document.createElement('div');ph.className='placeholder';ph.textContent='OSIRA';media.appendChild(ph);}
      const body=document.createElement('div');body.className='product-body';
      const cat=document.createElement('span');cat.textContent=item.category||'Wall Clock';
      const name=document.createElement('h2');name.textContent=item.name;
      const price=document.createElement('strong');price.textContent=money(item.price);
      body.append(cat,name,price);a.append(media,body);grid.appendChild(a);
    });
    section.hidden=false;
  })();
  </script>
</main>
<%- include('partials/footer', { site }) %>