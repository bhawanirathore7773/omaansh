<%- include('partials/header') %>
<main class="catalogue-page">
  <section class="section catalogue-hero">
    <div class="catalogue-intro">
      <span class="kicker">OSIRA WALL CLOCK CATALOGUE</span>
      <h1>Choose a wall clock by size, style or application.</h1>
      <p>Browse current active products for retail, wholesale, corporate gifting, promotional and custom requirements. For bulk orders, request current pricing based on quantity and specifications.</p>
    </div>
  </section>

  <section class="section catalogue-body">
    <div class="catalogue-toolbar">
      <div><strong><%= total %></strong> products</div>
      <span>Page <%= currentPage %> of <%= totalPages %></span>
    </div>
    <form class="catalogue-filter-box" method="get" action="/products">
      <div class="filter-search"><label for="q">Search</label><input id="q" name="q" value="<%= q %>" placeholder="e.g. 12 inch, promotional, square"></div>
      <div><label for="category">Collection</label><select id="category" name="category"><option value="">All collections</option><% categories.forEach(item => { %><option value="<%= item.slug %>" <%= category===item.slug?'selected':'' %>><%= item.name %></option><% }) %></select></div>
      <div><label for="size">Size</label><select id="size" name="size"><option value="">Any size</option><option <%= size==='8 inch'?'selected':'' %>>8 inch</option><option <%= size==='10 inch'?'selected':'' %>>10 inch</option><option <%= size==='12 inch'?'selected':'' %>>12 inch</option><option <%= size==='14 inch'?'selected':'' %>>14 inch</option></select></div>
      <div><label for="application">Application</label><select id="application" name="application"><option value="">Any application</option><option <%= application==='Corporate gifting, promotions'?'selected':'' %>>Corporate gifting, promotions</option><option <%= application==='Office, reception, meeting room'?'selected':'' %>>Office, reception, meeting room</option><option <%= application==='Home, office, retail'?'selected':'' %>>Home, office, retail</option><option <%= application==='Retail, gifting, décor'?'selected':'' %>>Retail, gifting, décor</option></select></div>
      <button class="btn primary" type="submit">Apply filters</button>
      <a class="btn secondary" href="/products">Reset</a>
    </form>

    <% if (products.length) { %>
      <div class="product-grid catalogue-grid">
        <% products.forEach(product => { %>
          <a class="product-card" href="/products/<%= product.slug %>">
            <div class="product-media">
              <% if(product.image){ %><img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" width="800" height="600"><% } else { %><div class="placeholder">OSIRA</div><% } %>
            </div>
            <div class="product-body">
              <span><%= product.category?.name || 'Wall Clock' %></span>
              <h2><%= product.name %></h2>
              <p><%= product.shortDescription || '' %></p>
              <strong><%= product.price ? 'From ₹' + Number(product.price).toLocaleString('en-IN') : 'Request current price' %></strong>
            </div>
          </a>
        <% }) %>
      </div>
      <% if (totalPages > 1) { %>
        <nav class="pagination" aria-label="Product pages">
          <% if (currentPage > 1) { %><a href="?<%= new URLSearchParams({q,category,size,application,page:String(currentPage-1)}).toString() %>">← Previous</a><% } %>
          <span>Page <%= currentPage %> / <%= totalPages %></span>
          <% if (currentPage < totalPages) { %><a href="?<%= new URLSearchParams({q,category,size,application,page:String(currentPage+1)}).toString() %>">Next →</a><% } %>
        </nav>
      <% } %>
    <% } else { %>
      <div class="empty-state"><h2>No matching wall clocks found.</h2><p>Try a broader search or send your quantity, preferred style and delivery city.</p><a class="btn primary" href="/#enquiry">Request a quotation</a></div>
    <% } %>
  </section>
</main>
<%- include('partials/footer', { site }) %>