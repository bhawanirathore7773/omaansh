<%- include('partials/header') %>
<main class="catalogue-page">
  <section class="section catalogue-hero">
    <div class="catalogue-intro">
      <span class="kicker"><%= section ? section.title.toUpperCase() : "OSIRA WALL CLOCK CATALOGUE" %></span>
      <h1><%= section ? section.title : "Find your wall clock." %></h1>
      <p><%= section?.description || "Search the range, refine by size or collection, and compare current products." %></p>
    </div>
  </section>

  <section class="section catalogue-body">
    <% const filterUrl = (omit) => { const params = new URLSearchParams(); if(q)params.set('q',q); if(category && omit!=='category')params.set('category',category); if(size && omit!=='size')params.set('size',size); if(application && omit!=='application')params.set('application',application); if(minPrice && omit!=='price')params.set('minPrice',minPrice); if(maxPrice && omit!=='price')params.set('maxPrice',maxPrice); if(sort && sort!=='recommended')params.set('sort',sort); if(sectionSlug)params.set('section',sectionSlug); return '/products'+(params.toString()?'?'+params.toString():''); }; %>
    <div class="catalogue-toolbar">
      <div><strong id="catalogue-total"><%= total %></strong> products <span class="catalogue-results-note">for your business needs</span></div>
      <label class="catalogue-sort-label">Sort by <select id="catalogueSort" aria-label="Sort products">
        <option value="recommended" <%= sort==='recommended'?'selected':'' %>>Recommended</option>
        <option value="newest" <%= sort==='newest'?'selected':'' %>>Newest first</option>
        <option value="price-low" <%= sort==='price-low'?'selected':'' %>>Price: low to high</option>
        <option value="price-high" <%= sort==='price-high'?'selected':'' %>>Price: high to low</option>
        <option value="name" <%= sort==='name'?'selected':'' %>>Name A–Z</option>
      </select></label>
    </div>
    <div class="catalogue-controls">
      <form class="catalogue-searchbar" method="get" action="/products" id="catalogueSearchForm">
        <label class="sr-only" for="catalogueSearch">Search wall clocks</label>
        <span aria-hidden="true">⌕</span>
        <input id="catalogueSearch" name="q" value="<%= q %>" placeholder="Search wall clocks, size, style or SKU">
        <% if(sectionSlug){ %><input type="hidden" name="section" value="<%= sectionSlug %>"><% } %>
        <% if(category){ %><input type="hidden" name="category" value="<%= category %>"><% } %>
        <% if(size){ %><input type="hidden" name="size" value="<%= size %>"><% } %>
        <% if(application){ %><input type="hidden" name="application" value="<%= application %>"><% } %>
        <% if(minPrice){ %><input type="hidden" name="minPrice" value="<%= minPrice %>"><% } %>
        <% if(maxPrice){ %><input type="hidden" name="maxPrice" value="<%= maxPrice %>"><% } %>
        <input type="hidden" name="sort" value="<%= sort || 'recommended' %>">
        <button type="submit" aria-label="Search products">Search</button>
      </form>
      <button type="button" class="catalogue-filter-trigger" id="openFilters" aria-haspopup="dialog" aria-controls="catalogueFilterSheet"><span class="filter-trigger-icon">☷</span> Filters <span class="filter-count" id="filterCount"><%= [category,size,application].filter(Boolean).length + ((minPrice || maxPrice) ? 1 : 0) %></span></button>
    </div>
    <div class="active-filter-chips" id="activeFilterChips">
      <% if(section){ %><a href="/products" class="filter-chip">Section: <%= section.title %> ×</a><% } %>
      <% if(category){ const cat=categories.find(x=>x.slug===category); %><a href="<%= filterUrl('category') %>" class="filter-chip">Collection: <%= cat?.name || category %> ×</a><% } %>
      <% if(size){ %><a href="<%= filterUrl('size') %>" class="filter-chip">Size: <%= size %> ×</a><% } %>
      <% if(application){ %><a href="<%= filterUrl('application') %>" class="filter-chip">Application ×</a><% } %>
      <% if(minPrice || maxPrice){ %><a href="<%= filterUrl('price') %>" class="filter-chip">Price range ×</a><% } %>
    </div>
    <div class="filter-sheet-backdrop" id="filterBackdrop" hidden></div>
    <aside class="filter-sheet" id="catalogueFilterSheet" role="dialog" aria-modal="true" aria-labelledby="filterSheetTitle" aria-hidden="true">
      <div class="filter-sheet-grabber"></div>
      <div class="filter-sheet-header"><div><span class="kicker">REFINE CATALOGUE</span><h2 id="filterSheetTitle">Find your wall clock</h2><p>Choose the specifications that match your order.</p></div><button type="button" id="closeFilters" class="filter-sheet-close" aria-label="Close filters">×</button></div>
      <form class="filter-sheet-form" method="get" action="/products" id="catalogueFilterForm">
        <input type="hidden" name="q" value="<%= q %>">
        <input type="hidden" name="sort" value="<%= sort || 'recommended' %>">
        <% if(sectionSlug){ %><input type="hidden" name="section" value="<%= sectionSlug %>"><% } %>
        <div class="filter-field"><label for="filterCategory">Collection</label><select id="filterCategory" name="category"><option value="">All collections</option><% categories.forEach(item => { %><option value="<%= item.slug %>" <%= category===item.slug?'selected':'' %>><%= item.name %></option><% }) %></select></div>
        <div class="filter-field"><label for="filterSize">Clock size</label><select id="filterSize" name="size"><option value="">Any size</option><% ['8 inch','10 inch','12 inch','14 inch','16 inch','18 inch','20 inch'].forEach(value=>{ %><option value="<%= value %>" <%= size===value?'selected':'' %>><%= value %></option><% }) %></select></div>
        <div class="filter-field"><label for="filterApplication">Application</label><select id="filterApplication" name="application"><option value="">Any application</option><% ['Corporate gifting, promotions','Office, reception, meeting room','Home, office, retail','Retail, gifting, décor'].forEach(value=>{ %><option value="<%= value %>" <%= application===value?'selected':'' %>><%= value %></option><% }) %></select></div>
        <fieldset class="filter-field price-range-field"><legend>Price range (₹)</legend><div class="price-range-inputs"><label for="filterMinPrice">Minimum<input id="filterMinPrice" name="minPrice" type="number" min="0" step="50" value="<%= minPrice %>" placeholder="₹ Min"></label><span>—</span><label for="filterMaxPrice">Maximum<input id="filterMaxPrice" name="maxPrice" type="number" min="0" step="50" value="<%= maxPrice %>" placeholder="₹ Max"></label></div><small>Leave blank if your budget is flexible.</small></fieldset>
        <div class="filter-sheet-actions"><a class="filter-reset" href="/products">Reset all</a><button class="btn primary" type="submit">Show <%= total %> products <span>→</span></button></div>
      </form>
    </aside>
    <% if (products.length) { %>
      <div class="product-grid catalogue-grid" id="catalogueProductGrid">
        <% products.forEach(product => { %>
          <a class="product-card catalogue-product-card" href="/products/<%= product.slug %>" data-product-slug="<%= product.slug %>">
            <div class="product-media">
              <% if(product.image){ %><img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" width="800" height="600"><% } else { %><div class="placeholder">OSIRA</div><% } %>
              <% if(product.isFeatured){ %><span class="product-status-badge featured">Featured</span><% } else if(product.isNewArrival){ %><span class="product-status-badge new">New arrival</span><% } else if(product.isBestseller){ %><span class="product-status-badge bestseller">Bestseller</span><% } %>
              <span class="product-image-label">OSIRA · WALL CLOCKS</span>
            </div>
            <div class="product-body">
              <span class="product-category-label"><%= product.category?.name || 'Wall Clock' %></span>
              <h2><%= product.name %></h2>
              <p><%= product.shortDescription || '' %></p>
              <% if(product.sku){ %><small class="catalogue-sku">SKU <%= product.sku %></small><% } %>
              <div class="catalogue-price-line"><strong><%= product.price ? '₹' + Number(product.price).toLocaleString('en-IN') : 'Price on enquiry' %></strong><% if(product.bulkPrice && product.price && Number(product.bulkPrice)<Number(product.price)){ %><span class="catalogue-discount"><%= Math.round((1-Number(product.bulkPrice)/Number(product.price))*100) %>% bulk saving</span><% } else if(product.bulkPrice || product.pricingTierTemplateId){ %><span class="catalogue-discount">Bulk pricing</span><% } %></div>
              <span class="catalogue-card-link">View details <b>↗</b></span>
            </div>
          </a>
        <% }) %>
      </div>
      <% if (currentPage < totalPages) { %><div class="catalogue-load-more-wrap"><button type="button" class="btn secondary catalogue-load-more" id="loadMoreProducts" data-page="<%= currentPage %>" data-total-pages="<%= totalPages %>">Load more wall clocks <span>↓</span></button><p>Showing <span id="shownCount"><%= products.length %></span> of <%= total %> products</p></div><% } %>
      <nav class="pagination catalogue-fallback-pagination" aria-label="Product pages">
        <% if (currentPage > 1) { %><a href="?<%= new URLSearchParams({q,category,size,application,minPrice,maxPrice,sort,section:sectionSlug,page:String(currentPage-1)}).toString() %>">← Previous</a><% } %>
        <span>Page <%= currentPage %> / <%= totalPages %></span>
        <% if (currentPage < totalPages) { %><a href="?<%= new URLSearchParams({q,category,size,application,minPrice,maxPrice,sort,section:sectionSlug,page:String(currentPage+1)}).toString() %>">Next →</a><% } %>
      </nav>
    <% } else { %>
      <div class="empty-state"><h2>No matching wall clocks found.</h2><p>Try removing a filter or send your quantity, preferred style and delivery city.</p><a class="btn primary" href="/#enquiry">Request a quotation</a><a class="btn secondary" href="/products">Clear all filters</a></div>
    <% } %>
  </section>
  <script>
  (() => {
    const sheet=document.getElementById('catalogueFilterSheet'), backdrop=document.getElementById('filterBackdrop');
    const openBtn=document.getElementById('openFilters'), closeBtn=document.getElementById('closeFilters');
    let savedScrollY=0;
    const open=()=>{savedScrollY=window.scrollY;document.body.style.top='-'+savedScrollY+'px';sheet.classList.add('is-open');sheet.setAttribute('aria-hidden','false');backdrop.hidden=false;requestAnimationFrame(()=>backdrop.classList.add('is-visible'));document.body.classList.add('filter-sheet-open');closeBtn.focus();};
    const close=()=>{sheet.classList.remove('is-open');sheet.setAttribute('aria-hidden','true');backdrop.classList.remove('is-visible');document.body.classList.remove('filter-sheet-open');document.body.style.top='';window.scrollTo(0,savedScrollY);setTimeout(()=>{if(!backdrop.classList.contains('is-visible'))backdrop.hidden=true;},300);openBtn.focus();};
    openBtn?.addEventListener('click',open);closeBtn?.addEventListener('click',close);backdrop?.addEventListener('click',close);
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&sheet?.classList.contains('is-open'))close();});
    const sort=document.getElementById('catalogueSort');
    sort?.addEventListener('change',()=>{const form=document.getElementById('catalogueSearchForm');form.querySelector('[name="sort"]').value=sort.value;form.requestSubmit();});
    const form=document.getElementById('catalogueFilterForm');
    form?.addEventListener('submit',e=>{const min=form.querySelector('[name="minPrice"]').value,max=form.querySelector('[name="maxPrice"]').value;if(min&&max&&Number(min)>Number(max)){e.preventDefault();alert('Maximum price should be greater than or equal to minimum price.');}});
    const count=document.getElementById('filterCount');
    const updateCount=()=>{const n=['category','size','application'].filter(name=>{const el=form?.elements.namedItem(name);return el&&el.value.trim()!=='';}).length+((form?.elements.namedItem('minPrice')?.value.trim()||form?.elements.namedItem('maxPrice')?.value.trim())?1:0);if(count)count.textContent=n;};
    form?.addEventListener('change',updateCount);form?.addEventListener('input',updateCount);
    const loadBtn=document.getElementById('loadMoreProducts'),grid=document.getElementById('catalogueProductGrid');
    const escapeHtml=value=>String(value??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    if(loadBtn){
      document.querySelector('.catalogue-fallback-pagination')?.classList.add('js-hidden');
      let loadingMore=false;
      const loadNextPage=async()=>{
        if(loadingMore||!document.getElementById('loadMoreProducts'))return;
        loadingMore=true;
        const next=Number(loadBtn.dataset.page)+1;
        if(next>Number(loadBtn.dataset.totalPages)){loadBtn.remove();return;}
        const label=loadBtn.innerHTML;loadBtn.disabled=true;loadBtn.textContent='Loading wall clocks…';
        const params=new URLSearchParams(window.location.search);params.set('page',String(next));
        try{
          const response=await fetch('/api/products?'+params.toString(),{headers:{'Accept':'application/json'}});
          if(!response.ok)throw new Error('Unable to load more products');
          const data=await response.json();
          data.items.forEach(p=>{
            const a=document.createElement('a');a.className='product-card catalogue-product-card';a.href='/products/'+encodeURIComponent(p.slug);a.dataset.productSlug=p.slug;
            const image=p.image?'<img src="'+escapeHtml(p.image)+'" alt="'+escapeHtml(p.name)+'" loading="lazy" width="800" height="600">':'<div class="placeholder">OSIRA</div>';
            const badge=p.isFeatured?'<span class="product-status-badge featured">Featured</span>':p.isNewArrival?'<span class="product-status-badge new">New arrival</span>':p.isBestseller?'<span class="product-status-badge bestseller">Bestseller</span>':'';
            const price=p.price?'₹'+Number(p.price).toLocaleString('en-IN'):'Price on enquiry';
            const bulk=p.bulkPrice&&p.price&&Number(p.bulkPrice)<Number(p.price)?'<span class="catalogue-discount">'+Math.round((1-Number(p.bulkPrice)/Number(p.price))*100)+'% bulk saving</span>':p.bulkPrice||p.pricingTierTemplateId?'<span class="catalogue-discount">Bulk pricing</span>':'';
            a.innerHTML='<div class="product-media">'+image+badge+'<span class="product-image-label">OSIRA · WALL CLOCKS</span></div><div class="product-body"><span class="product-category-label">'+escapeHtml(p.category?.name||'Wall Clock')+'</span><h2>'+escapeHtml(p.name)+'</h2><p>'+escapeHtml(p.shortDescription||'')+'</p>'+(p.sku?'<small class="catalogue-sku">SKU '+escapeHtml(p.sku)+'</small>':'')+'<div class="catalogue-price-line"><strong>'+price+'</strong>'+bulk+'</div><span class="catalogue-card-link">View details <b>↗</b></span></div>';
            grid.appendChild(a);
          });
          loadBtn.dataset.page=String(next);
          const shown=document.getElementById('shownCount');if(shown)shown.textContent=grid.children.length;
          if(next>=Number(loadBtn.dataset.totalPages)){loadBtn.remove();observer?.disconnect();}else{loadBtn.disabled=false;loadBtn.innerHTML=label;}
        }catch(error){loadBtn.disabled=false;loadBtn.textContent='Tap to retry loading';}
        finally{loadingMore=false;}
      };
      const observer='IntersectionObserver' in window?new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting))loadNextPage();},{rootMargin:'700px 0px'}):null;
      observer?.observe(loadBtn);
      loadBtn.addEventListener('click',loadNextPage);
    }
  })();
  </script>
</main>
<%- include('partials/footer', { site }) %>