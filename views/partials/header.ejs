<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle || site?.defaultMetaTitle || 'OSIRA | Wall Clock Manufacturer & Supplier in Jaipur' %></title>
  <meta name="description" content="<%= metaDescription || site?.defaultMetaDescription || 'OSIRA supplies wall clocks from Jaipur for retail, wholesale, corporate gifting, promotional branding and custom business requirements.' %>">
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <% const pageUrl = canonical || undefined; %>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= site?.businessName || 'OSIRA' %>">
  <meta property="og:title" content="<%= pageTitle || site?.defaultMetaTitle || 'OSIRA | Wall Clock Manufacturer & Supplier in Jaipur' %>">
  <meta property="og:description" content="<%= metaDescription || site?.defaultMetaDescription || '' %>">
  <% if (pageUrl) { %><meta property="og:url" content="<%= pageUrl %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css?v=20261020-about-city-guides-enquiry">
  <% if (typeof schemaJsonLd !== 'undefined' && schemaJsonLd) { %><script type="application/ld+json"><%- JSON.stringify(schemaJsonLd).replace(/</g, "\u003c") %></script><% } %>
</head>
<body>
<header class="site-header">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="OSIRA home">OSIRA</a>
    <nav aria-label="Primary navigation">
      <a href="/">Home</a><a href="/products">Wall Clocks</a><a href="/categories">Collections</a><a href="/services">Services</a><a href="/industries">Industries</a><a href="/blog">Guides</a><a href="/about">About</a>
    </nav>
    <a class="nav-cta" href="/#enquiry">Start an enquiry</a>
    <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-drawer"><span></span><span></span><span></span></button>
  </div>
</header>
<div class="drawer-backdrop" data-drawer-close hidden></div>
<aside class="mobile-drawer" id="mobile-drawer" aria-label="Mobile navigation" aria-hidden="true">
  <div class="drawer-head"><span class="drawer-title">MENU</span></div>
  <p class="drawer-kicker">EXPLORE OSIRA</p>
  <nav>
    <a href="/">Home <span>↗</span></a><a href="/products">Wall Clocks <span>↗</span></a><a href="/categories">Collections <span>↗</span></a><a href="/services">Services <span>↗</span></a><a href="/industries">Industries <span>↗</span></a><a href="/blog">Buying Guides <span>↗</span></a><a href="/about">About OSIRA <span>↗</span></a>
  </nav>
  <a class="drawer-cta" href="/#enquiry">Start an enquiry <span>→</span></a>
  <a class="drawer-reseller-cta" href="/reseller"><span class="drawer-reseller-icon" aria-hidden="true">↗</span><span><strong>Become a reseller</strong><small>Explore components, sizes and wholesale options</small></span><span aria-hidden="true">→</span></a>
  <p class="drawer-footnote">Wall clocks for retail, workplaces and business orders.</p>
</aside>
<script>
(() => {
 const toggle=document.querySelector('.menu-toggle');
 const drawer=document.querySelector('.mobile-drawer');
 const backdrop=document.querySelector('.drawer-backdrop');
 if(!toggle||!drawer||!backdrop)return;
 const originalParent=toggle.parentNode;
 const originalNext=toggle.nextSibling;
 let savedScrollY=0, previousHtmlOverflow='', previousBodyOverflow='';
 const preventBackgroundScroll=(event)=>{if(!drawer.contains(event.target))event.preventDefault();};
 const open=()=>{
   savedScrollY=window.scrollY||window.pageYOffset||0;
   // Keep the document in its natural scroll position. Fixed-positioning the body
   // causes iOS Safari to shift the page when the drawer opens.
   const rect=toggle.getBoundingClientRect();
   document.documentElement.style.setProperty('--menu-toggle-left',rect.left+'px');
   document.documentElement.style.setProperty('--menu-toggle-top',rect.top+'px');
   previousHtmlOverflow=document.documentElement.style.overflow;
   previousBodyOverflow=document.body.style.overflow;
   document.documentElement.style.overflow='hidden';
   document.body.style.overflow='hidden';
   document.body.classList.add('drawer-open');
   // Lock scrolling without changing the body's position or scroll origin.
   // Move the same button out of the header stacking context so its X stays
   // above the drawer while the original header is dimmed behind the overlay.
   document.body.appendChild(toggle);
   toggle.classList.add('is-open');
   drawer.classList.add('is-open');
   backdrop.hidden=false;
   requestAnimationFrame(()=>backdrop.classList.add('is-visible'));
   toggle.setAttribute('aria-expanded','true');
   toggle.setAttribute('aria-label','Close navigation menu');
   drawer.setAttribute('aria-hidden','false');
   document.addEventListener('touchmove',preventBackgroundScroll,{passive:false});
 };
 const close=()=>{
   drawer.classList.remove('is-open');
   toggle.classList.remove('is-open');
   backdrop.classList.remove('is-visible');
   toggle.setAttribute('aria-expanded','false');
   toggle.setAttribute('aria-label','Open navigation menu');
   drawer.setAttribute('aria-hidden','true');
   document.body.classList.remove('drawer-open');
   document.documentElement.style.overflow=previousHtmlOverflow;
   document.body.style.overflow=previousBodyOverflow;
   document.documentElement.style.removeProperty('--menu-toggle-left');
   document.documentElement.style.removeProperty('--menu-toggle-top');
   document.removeEventListener('touchmove',preventBackgroundScroll);
   if(originalParent)originalParent.insertBefore(toggle,originalNext&&originalNext.parentNode===originalParent?originalNext:null);
   window.scrollTo(0,savedScrollY);
   window.setTimeout(()=>{if(!backdrop.classList.contains('is-visible'))backdrop.hidden=true;},280);
 };
 toggle.addEventListener('click',()=>drawer.classList.contains('is-open')?close():open());
 backdrop.addEventListener('click',close);
 drawer.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&drawer.classList.contains('is-open'))close();});
})();
</script>