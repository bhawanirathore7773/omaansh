<footer class="footer">
  <div class="footer-inner footer-v2">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="<%= site?.businessName || 'OSIRA' %> home"><%= site?.businessName || 'OSIRA' %></a>
      <p class="footer-tagline"><%= site?.tagline || 'Wall clocks for retail, workplaces and business orders.' %></p>
      <p class="footer-note">Jaipur-based supply for wholesale, corporate gifting, promotional branding and custom/OEM requirements.</p>
      <p class="footer-legal-name">OSIRA is the brand of Omaansh Industries.</p>
      <div class="footer-social" aria-label="OSIRA social profiles">
        <% if (site?.facebookUrl) { %>
          <a class="social-icon" href="<%= site.facebookUrl %>" target="_blank" rel="noopener noreferrer" aria-label="OSIRA on Facebook" title="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-3.31 0-5 1.79-5 5v3H6v4h3v8h4v-8h3.5l.5-4H13V9c0-.67.33-1 1-1Z"/></svg></a>
        <% } %>
        <% if (site?.instagramUrl) { %>
          <a class="social-icon" href="<%= site.instagramUrl %>" target="_blank" rel="noopener noreferrer" aria-label="OSIRA on Instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
        <% } %>
        <% if (site?.linkedinUrl) { %>
          <a class="social-icon" href="<%= site.linkedinUrl %>" target="_blank" rel="noopener noreferrer" aria-label="OSIRA on LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.5A2.5 2.5 0 1 1 5 8.5 2.5 2.5 0 0 1 5 3.5ZM3 10h4v11H3V10Zm7 0h3.8v1.5h.1c.53-.96 1.83-1.97 3.77-1.97 4.03 0 4.77 2.65 4.77 6.1V21h-4v-4.76c0-1.14-.02-2.61-1.59-2.61-1.59 0-1.83 1.24-1.83 2.52V21h-4V10Z"/></svg></a>
        <% } %>
        <% if (site?.indiamartUrl) { %>
          <a class="social-icon social-indiamart" href="<%= site.indiamartUrl %>" target="_blank" rel="noopener noreferrer" aria-label="OSIRA on IndiaMART" title="IndiaMART">IM</a>
        <% } %>
      </div>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <a href="/products">Wall clocks</a>
      <a href="/categories">Collections</a>
      <a href="/services">Services</a>
      <a href="/industries">Industries</a>
      <a href="/blog">Buying guides</a>
    </div>

    <div class="footer-col">
      <h4>Business</h4>
      <a href="/services/wholesale-wall-clocks">Wholesale supply</a>
      <a href="/services/corporate-gifting">Corporate gifting</a>
      <a href="/services/promotional-wall-clocks">Promotional branding</a>
      <a href="/services/custom-oem-wall-clocks">Custom &amp; OEM</a>
      <a href="/reseller">Become a reseller</a>
      <a href="/cities/jaipur">Wall clocks in Jaipur</a>
    </div>

    <div class="footer-col footer-contact">
      <h4>Contact</h4>
      <p><%= site?.streetAddress || 'Jaipur, Rajasthan, India' %></p>
      <a href="tel:<%= site?.primaryPhone || '+91141616961' %>"><%= site?.primaryPhone || '+91 141 616961' %></a>
      <a href="mailto:<%= site?.email || 'hello@omaansh.com' %>"><%= site?.email || 'hello@omaansh.com' %></a>
      <% if(site?.whatsappNumber){ %><a href="https://wa.me/<%= site.whatsappNumber %>" target="_blank" rel="noopener noreferrer">WhatsApp enquiry</a><% } %>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© <%= new Date().getFullYear() %> <%= site?.businessName || 'OSIRA' %>. All rights reserved.</span>
    <span>Wall clock manufacturer &amp; supplier in Jaipur</span>
  </div>

</footer>
<div class="global-enquiry-modal" id="globalEnquiryModal" aria-hidden="true">
  <button class="global-enquiry-backdrop" type="button" data-close-enquiry aria-label="Close enquiry form"></button>
  <section class="global-enquiry-dialog" role="dialog" aria-modal="true" aria-labelledby="globalEnquiryTitle">
    <button class="global-enquiry-close" type="button" data-close-enquiry aria-label="Close enquiry form">×</button>
    <span class="kicker">OSIRA · BULK & BUSINESS ORDERS</span><h2 id="globalEnquiryTitle">Tell us what you need.</h2>
    <p>Share the quantity and delivery city. Our team can follow up to confirm suitable options.</p>
    <form class="enquiry-form global-enquiry-form" method="post" action="/enquiries">
      <input type="text" name="name" placeholder="Your name" autocomplete="name" required>
      <input type="tel" name="phone" placeholder="Phone number" autocomplete="tel" required>
      <input type="email" name="email" placeholder="Email (optional)" autocomplete="email">
      <input type="text" name="city" placeholder="Delivery city" autocomplete="address-level2" required>
      <textarea name="message" rows="4" placeholder="Quantity, size, style, branding or other requirement" required></textarea>
      <input class="honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn primary" type="submit">Send requirement →</button>
    </form>
  </section>
</div>
<a class="floating-whatsapp" href="https://wa.me/<%= (site?.whatsappNumber || '919509912556').replace(/[^0-9]/g,'') %>?text=<%= encodeURIComponent('Hello OSIRA, I would like to enquire about wall clocks and bulk orders.') %>" target="_blank" rel="noopener noreferrer" aria-label="Chat with OSIRA on WhatsApp" title="Chat on WhatsApp"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3.2A12.6 12.6 0 0 0 5.2 22.3L3.5 28.5l6.4-1.7A12.6 12.6 0 1 0 16 3.2Zm0 22.8c-2 0-3.9-.5-5.6-1.6l-.4-.2-3.8 1 1-3.7-.3-.4A10.2 10.2 0 1 1 16 26Zm5.6-7.6c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-.9 1.2-.4.2-.7.1a8.4 8.4 0 0 1-2.5-1.5 9.2 9.2 0 0 1-1.7-2.1c-.2-.3 0-.5.2-.7l.5-.6.2-.5c.1-.2 0-.4 0-.6l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8 1.2 3.2 1.4 3.4a12.3 12.3 0 0 0 4.7 4.1c.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.8-.7 2-1.4s.3-1.3.2-1.4-.2-.2-.5-.4Z"/></svg></a>
<script>
(()=> {
 const modal=document.getElementById('globalEnquiryModal'); if(!modal)return;
 const open=()=>{modal.classList.add('is-open');modal.setAttribute('aria-hidden','false');document.body.classList.add('enquiry-modal-open');};
 const close=()=>{modal.classList.remove('is-open');modal.setAttribute('aria-hidden','true');document.body.classList.remove('enquiry-modal-open');};
 document.querySelectorAll('[data-open-enquiry]').forEach(el=>el.addEventListener('click',event=>{event.preventDefault();open();}));
 modal.querySelectorAll('[data-close-enquiry]').forEach(el=>el.addEventListener('click',close));
 document.addEventListener('keydown',event=>{if(event.key==='Escape')close();});
 document.querySelectorAll('a[href="/#enquiry"],a[href="#enquiry"]').forEach(el=>el.addEventListener('click',event=>{if(!el.closest('.footer')){event.preventDefault();open();}}));
})();
</script>
</body>
</html>