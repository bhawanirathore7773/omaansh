<%- include('partials/header') %>
<main class="solution-detail service-detail-page">
<section class="section solution-detail-hero service-detail-hero-banner">
  <div class="breadcrumbs"><a href="/services">Services</a><span>›</span><%= service.name %></div>
  <div class="solution-detail-copy"><span class="kicker">OSIRA BUSINESS SERVICE</span><h1><%= service.h1Heading %></h1><p><%= service.heroSubheading || service.shortDescription %></p><div class="actions"><a class="btn primary" href="/#enquiry">Discuss your requirement →</a><a class="btn secondary" href="/products">Browse wall clocks</a></div><div class="service-detail-proof"><span>01 · Clear product direction</span><span>02 · Quantity-led quotation</span><span>03 · Business order support</span></div></div>
  <div class="service-detail-banner"><img src="<%= service.heroImage || 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1200&q=85' %>" alt="<%= service.name %> by OSIRA" fetchpriority="high"><div class="service-detail-banner-card"><span>OSIRA · JAIPUR</span><strong><%= service.name %></strong><small>Wholesale · Corporate · Custom orders</small></div></div>
</section>
<section class="section solution-content"><article><span class="kicker">OVERVIEW</span><div class="rich-copy"><%- service.fullDescription %></div></article><% if(service.processContent){ %><article><span class="kicker">HOW IT WORKS</span><div class="rich-copy"><%- service.processContent %></div></article><% } %><% if(service.benefitsContent){ %><article><span class="kicker">WHY THIS ROUTE</span><div class="rich-copy"><%- service.benefitsContent %></div></article><% } %></section>
<% if(serviceProducts && serviceProducts.length){ %><section class="section service-products-section"><div class="section-head"><div><span class="kicker">PRODUCTS FOR THIS SERVICE</span><h2>Wall clocks to explore</h2><p>Selected by OSIRA for this service. Ask us to confirm current availability and quantity pricing.</p></div><a class="text-link" href="/products">View all wall clocks →</a></div><div class="product-grid service-products-grid"><% serviceProducts.forEach(product=>{ %><a class="product-card" href="/products/<%= product.slug %>"><div class="product-media"><% if(product.image){ %><img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" width="600" height="600"><% }else{ %><div class="placeholder">OSIRA</div><% } %></div><div class="product-body"><span><%= product.category?.name||'Wall Clock' %></span><h3><%= product.name %></h3><strong><%= product.price ? '₹'+Number(product.price).toLocaleString('en-IN') : 'Price on enquiry' %></strong><small>View product →</small></div></a><% }) %></div></section><% } %>
<section class="section solution-cta"><div><span class="kicker">READY TO DISCUSS?</span><h2>Share the quantity, product direction and delivery city.</h2></div><a class="btn primary" href="/#enquiry">Start an enquiry →</a></section>
</main><%- include('partials/footer',{site}) %>