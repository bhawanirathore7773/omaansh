<%- include('partials/header') %>
<main>
  <section class="section">
    <div class="section-head">
      <div>
        <span class="kicker">INDUSTRIES</span>
        <h1>Wall clocks selected for commercial spaces and business programmes.</h1>
        <p>Explore practical sourcing options for hotels, offices, retail, education, healthcare and other environments where clocks need to work with the space and the brand.</p>
      </div>
    </div>
    <div class="industry-grid">
      <% industries.forEach(industry => { %>
        <a class="industry-card" href="/industries/<%= industry.slug %>">
          <span class="kicker"><%= industry.iconClass || 'OSIRA' %></span>
          <h2><%= industry.h1Heading %></h2>
          <p><%= industry.heroSubheading || industry.introContent.replace(/<[^>]*>/g, '').slice(0, 180) %></p>
          <strong>View solution →</strong>
        </a>
      <% }) %>
    </div>
  </section>
</main>
<%- include('partials/footer', { site }) %>
