<%- include('partials/header', {title:'OSIRA Admin Dashboard', user}) %>
<div class="dashboard-welcome">
  <div><p class="admin-kicker">OSIRA CONTROL CENTER</p><h1>Good work starts with a clear view.</h1><p>Manage your catalogue, website content and incoming business enquiries from one workspace.</p></div>
  <div class="dashboard-welcome-actions"><a class="admin-secondary" href="/" target="_blank" rel="noopener">Preview website ↗</a><a class="admin-button" href="/admin/products/new">＋ Add product</a></div>
</div>
<section class="dashboard-section-head"><div><h2>Business snapshot</h2><p>Live totals from your current website database.</p></div><span class="dashboard-live"><i></i> Connected workspace</span></section>
<section class="admin-stats dashboard-stat-grid">
  <a href="/admin/products" class="stat-card stat-primary"><span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/></svg></span><span class="stat-label">Active products</span><strong><%= data.products %></strong><small>Manage catalogue →</small></a>
  <a href="/admin/categories" class="stat-card"><span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><rect x="3.5" y="4" width="17" height="16" rx="2"/><path d="M8 4v16M16 4v16M4 9h16M4 15h16"/></svg></span><span class="stat-label">Collections</span><strong><%= data.categories %></strong><small>Organise products →</small></a>
  <a href="/admin/enquiries" class="stat-card"><span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M7 17 17 7M8 7h9v9"/></svg></span><span class="stat-label">All enquiries</span><strong><%= data.enquiries %></strong><small>View lead pipeline →</small></a>
  <a href="/admin/enquiries?status=new" class="stat-card stat-attention"><span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="m12 3 2.25 6.75L21 12l-6.75 2.25L12 21l-2.25-6.75L3 12l6.75-2.25L12 3Z"/></svg></span><span class="stat-label">Needs attention</span><strong><%= data.newEnquiries %></strong><small>New enquiries →</small></a>
</section>
<section class="dashboard-work-grid">
  <div class="dashboard-panel sales-panel">
    <div class="panel-heading"><div><p class="admin-kicker">SALES PIPELINE</p><h2>Enquiry progress</h2><p>Follow each lead from first contact to a confirmed order.</p></div><a href="/admin/enquiries" class="text-action">Open enquiries ↗</a></div>
    <div class="pipeline-list">
      <a href="/admin/enquiries?status=new"><span class="pipeline-symbol pipeline-new">✦</span><span class="pipeline-copy"><strong>New</strong><small>Needs first response</small></span><b><%= data.newEnquiries %></b></a>
      <a href="/admin/enquiries?status=contacted"><span class="pipeline-symbol pipeline-contacted">↗</span><span class="pipeline-copy"><strong>Contacted</strong><small>Conversation started</small></span><b><%= data.contactedEnquiries %></b></a>
      <a href="/admin/enquiries?status=quoted"><span class="pipeline-symbol pipeline-quoted">₹</span><span class="pipeline-copy"><strong>Quoted</strong><small>Price shared with buyer</small></span><b><%= data.quotedEnquiries %></b></a>
      <a href="/admin/enquiries?status=won"><span class="pipeline-symbol pipeline-won">✓</span><span class="pipeline-copy"><strong>Won</strong><small>Converted to business</small></span><b><%= data.wonEnquiries %></b></a>
    </div>
    <div class="panel-footer-note">Tip: update lead status and add follow-up notes in the Enquiries section.</div>
  </div>
  <div class="dashboard-panel">
    <div class="panel-heading"><div><p class="admin-kicker">QUICK ACTIONS</p><h2>Get things done</h2><p>Common tasks, one click away.</p></div></div>
    <div class="quick-action-list">
      <a href="/admin/products/new"><span class="quick-action-icon">＋</span><span><strong>Add a new product</strong><small>Images, pricing, specifications & SEO</small></span><b>→</b></a>
      <a href="/admin/banners"><span class="quick-action-icon">▧</span><span><strong>Update homepage carousel</strong><small>Manage desktop and mobile banners</small></span><b>→</b></a>
      <a href="/admin/enquiries?status=new"><span class="quick-action-icon">↗</span><span><strong>Respond to new leads</strong><small>Keep wholesale buyers moving</small></span><b>→</b></a>
      <a href="/admin/settings"><span class="quick-action-icon">⚙</span><span><strong>Edit website details</strong><small>Contact, WhatsApp, address & SEO</small></span><b>→</b></a>
    </div>
  </div>
</section>
<section class="dashboard-section-head content-section-head"><div><h2>Website content</h2><p>Manage the pages that help customers discover your business.</p></div></section>
<section class="admin-quick-grid dashboard-content-grid">
  <a href="/admin/services"><span class="content-tile-icon">◇</span><strong>Services</strong><span><%= data.services %> published pages</span><b>Manage →</b></a>
  <a href="/admin/industries"><span class="content-tile-icon">▥</span><strong>Industries</strong><span><%= data.industries %> published pages</span><b>Manage →</b></a>
  <a href="/admin/cities"><span class="content-tile-icon">⌖</span><strong>City landing pages</strong><span><%= data.cities %> published pages</span><b>Manage →</b></a>
  <a href="/admin/blog"><span class="content-tile-icon">≡</span><strong>Blog & SEO</strong><span><%= data.blogs %> published guides</span><b>Manage →</b></a>
</section>
<section class="dashboard-bottom-banner"><div><span class="banner-spark">✦</span><div><h2>Keep your storefront up to date</h2><p>Review product details, image quality, enquiry response times and page metadata regularly.</p></div></div><a class="admin-button" href="/admin/products">Review catalogue →</a></section>
<%- include('partials/footer') %>
