<%- include('partials/header', {title:'Collections | OSIRA Admin', user}) %><div class="admin-heading"><div><p class="admin-kicker">STRUCTURE</p><h1>Collections</h1><p>Organise products and collection-level SEO.</p></div><a class="admin-button" href="/admin/categories/new">+ Add collection</a></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Collection</th><th>Products</th><th>Featured</th><th>Action</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><strong><%= row.name %></strong><small>/<%= row.slug %></small></td><td><%= row._count.products %></td><td><%= row.isFeatured?'Yes':'No' %></td><td><a class="table-link" href="/admin/categories/<%= row.id %>/edit">Edit</a></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>