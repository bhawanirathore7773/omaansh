<%- include('partials/header', {title:'Homepage Banners | OSIRA Admin', user}) %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
<div class="admin-heading"><div><p class="admin-kicker">HOMEPAGE</p><h1>Image carousel</h1><p>Upload any image, crop it to the live carousel frame, then save to publish.</p></div><div class="admin-heading-actions"><a class="admin-secondary" href="/" target="_blank" rel="noopener noreferrer">Preview website ↗</a><form method="post" action="/admin/banners/add"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><button class="admin-button" type="submit" <%= rows.length >= 20 ? 'disabled' : '' %>>＋ Add another slide</button></form></div></div>
<% if (saved) { %><div class="admin-success">Banner images saved successfully.</div><% } %>
<div class="banner-help"><strong>Choose the right banner frame</strong><span>Desktop: 1600 × 485 px · 3.3:1</span><span>Mobile: 1200 × 675 px · 16:9</span><small>You can choose any JPG, PNG, WebP or AVIF image. Before upload, a crop window lets you reposition and zoom the image to fit the exact frame. The cropped image is uploaded, so the preview and homepage proportions stay consistent.</small></div>
<form method="post" action="/admin/banners/save" class="home-banner-admin-form">
  <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
  <% rows.forEach((banner, index) => { %>
  <section class="editor-card home-banner-editor">
    <div class="banner-editor-heading"><div><span class="banner-number">0<%= index + 1 %></span><div><h2>Banner <%= index + 1 %></h2><p>Slide <%= index + 1 %> of <%= rows.length %></p></div></div><label class="toggle-field"><input type="checkbox" name="banners[<%= index %>][isActive]" <%= banner.isActive ? 'checked' : '' %>> Show on homepage</label></div>
    <input type="hidden" name="banners[<%= index %>][id]" value="<%= banner.id %>">
    <input type="hidden" name="banners[<%= index %>][title]" value="<%= banner.title || ('OSIRA banner ' + (index + 1)) %>">
    <input type="hidden" name="banners[<%= index %>][subtitle]" value="">
    <input type="hidden" name="banners[<%= index %>][buttonLabel]" value="">
    <input type="hidden" name="banners[<%= index %>][displayOrder]" value="<%= index + 1 %>">
    <div class="banner-preview image-only-preview" style="--banner-bg:<%= banner.backgroundColor || '#f7f5ef' %>">
      <% if (banner.desktopImage || banner.mobileImage) { %><picture><% if (banner.mobileImage) { %><source media="(max-width:700px)" srcset="<%= banner.mobileImage %>"><% } %><img src="<%= banner.desktopImage || banner.mobileImage %>" alt="Banner <%= index + 1 %> preview" loading="lazy"></picture><% } else { %><div class="empty-banner-preview"><strong>Banner <%= index + 1 %></strong><span>Image not added yet</span></div><% } %>
    </div>
    <div class="field-grid">
      <label>Desktop banner image <span class="banner-dimensions">1600 × 485 px · 3.3:1 wide</span><input type="text" data-image-url name="banners[<%= index %>][desktopImage]" value="<%= banner.desktopImage || '' %>" placeholder="/uploads/banners/..."><input type="file" accept="image/*" data-image-file data-crop-type="desktop"><button class="admin-button upload-banner-button" type="button" data-open-crop data-crop-type="desktop">Choose & crop desktop image</button><small>Recommended output: 1600 × 485 px to match the desktop carousel frame. You can upload an image of any ratio and adjust the crop.</small></label>
      <label>Mobile banner image <span class="banner-dimensions">1200 × 675 px · 16:9 landscape</span><input type="text" data-image-url name="banners[<%= index %>][mobileImage]" value="<%= banner.mobileImage || '' %>" placeholder="/uploads/banners/..."><input type="file" accept="image/*" data-image-file data-crop-type="mobile"><button class="admin-button upload-banner-button" type="button" data-open-crop data-crop-type="mobile">Choose & crop mobile image</button><small>Recommended output: 1200 × 675 px to match the mobile carousel frame. Mobile crop is separate so important content stays visible.</small></label>
    </div>
    <input type="hidden" name="banners[<%= index %>][backgroundColor]" value="<%= banner.backgroundColor || '#17212b' %>">
  </section>
  <% }) %>
  <div class="banner-save-bar"><p><%= rows.length %> slides · Uploading alone does not publish; click Save all banner images.</p><button class="admin-button" type="submit">Save all banner images</button></div>
</form>
<div class="crop-modal" id="bannerCropModal" aria-hidden="true">
  <div class="crop-dialog" role="dialog" aria-modal="true" aria-labelledby="cropDialogTitle">
    <div class="crop-dialog-head"><div><p class="admin-kicker">IMAGE EDITOR</p><h2 id="cropDialogTitle">Adjust banner crop</h2><p id="cropDimensions">Select the visible area for your banner.</p></div><button type="button" class="crop-close" data-crop-cancel aria-label="Close crop editor">×</button></div>
    <div class="crop-stage"><img id="bannerCropImage" alt="Image crop preview"></div>
    <div class="crop-dialog-foot"><span id="cropRatioLabel">4:3 · Desktop</span><div><button type="button" class="admin-secondary" data-crop-cancel>Cancel</button><button type="button" class="admin-button" id="cropUploadButton">Crop & upload</button></div></div>
    <p class="crop-tip">Drag the image to reposition it and use the zoom controls to fine-tune the crop.</p>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
<script>
(() => {
  const modal = document.getElementById('bannerCropModal');
  const cropImage = document.getElementById('bannerCropImage');
  const cropButton = document.getElementById('cropUploadButton');
  const cropRatioLabel = document.getElementById('cropRatioLabel');
  const cropDimensions = document.getElementById('cropDimensions');
  let cropper = null;
  let activeFile = null;
  let activeButton = null;
  let activeUrlInput = null;
  let activePreview = null;
  let activeType = 'desktop';

  document.querySelectorAll('[data-open-crop]').forEach(button => {
    button.addEventListener('click', () => {
      const label = button.closest('label');
      const fileInput = label.querySelector('[data-image-file]');
      const file = fileInput.files && fileInput.files[0];
      if (!file) { alert('Please choose an image first.'); return; }
      if (!file.type.startsWith('image/')) { alert('Please select a valid image file.'); return; }
      if (file.size > 8 * 1024 * 1024) { alert('Image must be 8 MB or smaller.'); return; }
      if (typeof Cropper === 'undefined') { alert('Image editor could not load. Please refresh the page and try again.'); return; }
      activeFile = file;
      activeButton = button;
      activeUrlInput = label.querySelector('[data-image-url]');
      activePreview = button.closest('.home-banner-editor').querySelector('.banner-preview');
      activeType = button.dataset.cropType || 'desktop';
      const isMobile = activeType === 'mobile';
      cropRatioLabel.textContent = isMobile ? '16:9 · Mobile' : '3.3:1 · Desktop';
      cropDimensions.textContent = isMobile ? 'Output image: 1200 × 675 px' : 'Output image: 1600 × 485 px';
      cropImage.onload = () => {
        if (cropper) cropper.destroy();
        cropper = new Cropper(cropImage, {
          aspectRatio: isMobile ? 16 / 9 : 3.3 / 1,
          viewMode: 1,
          dragMode: 'move',
          autoCropArea: 0.92,
          responsive: true,
          restore: false,
          guides: true,
          center: true,
          highlight: false,
          background: false,
          movable: true,
          zoomable: true,
          zoomOnWheel: true,
          rotatable: false,
          scalable: false,
          minContainerWidth: 280,
          minContainerHeight: isMobile ? 340 : 280,
        });
      };
      cropImage.src = URL.createObjectURL(file);
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('crop-modal-open');
    });
  });

  function closeModal() {
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('crop-modal-open');
    if (cropper) { cropper.destroy(); cropper = null; }
    if (cropImage.src.startsWith('blob:')) URL.revokeObjectURL(cropImage.src);
    activeFile = activeButton = activeUrlInput = activePreview = null;
  }
  document.querySelectorAll('[data-crop-cancel]').forEach(button => button.addEventListener('click', closeModal));
  modal.addEventListener('click', event => { if (event.target === modal) closeModal(); });
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal(); });

  cropButton.addEventListener('click', async () => {
    if (!cropper || !activeFile || !activeButton) return;
    const isMobile = activeType === 'mobile';
    const canvas = cropper.getCroppedCanvas({
      width: isMobile ? 1200 : 1600,
      height: isMobile ? 675 : 485,
      imageSmoothingEnabled: true,
      imageSmoothingQuality: 'high',
      fillColor: '#ffffff'
    });
    if (!canvas) { alert('Could not crop this image. Please try another image.'); return; }
    cropButton.disabled = true;
    const originalText = cropButton.textContent;
    cropButton.textContent = 'Preparing image…';
    try {
      const blob = await new Promise((resolve, reject) => canvas.toBlob(result => result ? resolve(result) : reject(new Error('Could not prepare cropped image.')), 'image/jpeg', 0.92));
      const croppedFile = new File([blob], (activeFile.name.replace(/\.[^.]+$/, '') || 'banner') + (isMobile ? '-mobile-crop.jpg' : '-desktop-crop.jpg'), {type:'image/jpeg'});
      const form = document.querySelector('.home-banner-admin-form');
      const data = new FormData();
      data.append('image', croppedFile);
      data.append('csrfToken', form.querySelector('[name="csrfToken"]').value);
      const button = activeButton;
      const urlInput = activeUrlInput;
      const preview = activePreview;
      button.disabled = true;
      button.textContent = 'Uploading cropped image…';
      const response = await fetch('/admin/banners/upload', {method:'POST', body:data, credentials:'same-origin'});
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Upload failed');
      urlInput.value = result.url;
      preview.style.setProperty('--banner-bg', '#f7f5ef');
      let img = preview.querySelector('img');
      if (!img) { preview.innerHTML = ''; img = document.createElement('img'); img.alt = 'Banner preview'; preview.appendChild(img); }
      img.src = result.url + '?preview=' + Date.now();
      const picture = preview.querySelector('picture');
      if (picture) picture.replaceWith(img);
      button.textContent = 'Uploaded ✓ · Choose another';
      closeModal();
    } catch (error) {
      alert(error.message || 'Unable to crop and upload image.');
      activeButton.textContent = 'Retry crop & upload';
    } finally {
      cropButton.disabled = false;
      cropButton.textContent = 'Crop & upload';
      document.querySelectorAll('[data-open-crop]').forEach(button => { button.disabled = false; });
    }
  });
})();
</script>
<%- include('partials/footer') %>