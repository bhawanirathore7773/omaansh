<%- include('partials/header', {title:(product?'Edit':'Add')+' Product | OSIRA Admin', user}) %>
<div class="admin-heading"><div><p class="admin-kicker">CATALOGUE</p><h1><%= product?'Edit product':'Add product' %></h1><p>Keep product content, commercial details and SEO metadata consistent.</p></div></div>
<% const productImages = Array.isArray(product?.additionalImages) ? product.additionalImages : []; %>
<form method="post" action="/admin/products/save" class="editor-grid">
<input type="hidden" name="csrfToken" value="<%= (typeof csrfToken!=='undefined'&&csrfToken)||'' %>"><% if(product){ %><input type="hidden" name="id" value="<%= product.id %>"><% } %>
<section class="editor-card"><h2>Product details</h2><div class="field-grid"><label>Name<input name="name" required value="<%= product?.name||'' %>"></label><label>Slug<input name="slug" required value="<%= product?.slug||'' %>"></label><label>Category<select name="categoryId" required><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= product?.categoryId===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>SKU<input name="sku" value="<%= product?.sku||'' %>"></label><label>Price<input type="number" step="0.01" name="price" value="<%= product?.price||'' %>"></label><label>Bulk price<input type="number" step="0.01" name="bulkPrice" value="<%= product?.bulkPrice||'' %>"></label><label>MOQ<input type="number" min="1" name="moq" value="<%= product?.moq||1 %>"></label><label>Main image URL<input name="image" value="<%= product?.image||'' %>" placeholder="https://.../main-product.webp"><small>Main listing image. Use a direct image URL.</small></label></div>
<div class="product-gallery-admin"><h3>Product gallery images</h3><p>Add up to four extra views. These appear as thumbnails below the main product image on the product page.</p><div class="field-grid">
<% [0,1,2,3].forEach(i=>{ %><label>Gallery image <%= i+1 %><input name="additionalImage<%= i+1 %>" value="<%= productImages[i] || '' %>" placeholder="https://.../product-view-<%= i+1 %>.webp"></label><% }) %>
</div></div><label>Description<textarea name="description" rows="7"><%= product?.description||'' %></textarea></label><label>Short description<input name="shortDescription" value="<%= product?.shortDescription||'' %>"></label><label>Specifications<textarea name="specifications" rows="5"><%= product?.specifications||'' %></textarea></label></section>
<section class="editor-card"><h2>SEO & visibility</h2><label>Meta title<input name="metaTitle" maxlength="70" value="<%= product?.metaTitle||'' %>"></label><label>Meta description<textarea name="metaDescription" maxlength="160" rows="4"><%= product?.metaDescription||'' %></textarea></label><label>Meta keywords<input name="metaKeywords" value="<%= product?.metaKeywords||'' %>"></label><label>Brand<input name="brand" value="<%= product?.brand||'OSIRA' %>"></label><label>Availability<select name="availability"><option value="InStock" <%= product?.availability==='InStock'?'selected':'' %>>In stock</option><option value="OutOfStock" <%= product?.availability==='OutOfStock'?'selected':'' %>>Out of stock</option></select></label><div class="checks"><label><input type="checkbox" name="isActive" <%= product?.isActive!==false?'checked':'' %>> Active</label><label><input type="checkbox" name="isFeatured" <%= product?.isFeatured?'checked':'' %>> Featured</label><label><input type="checkbox" name="isBestseller" <%= product?.isBestseller?'checked':'' %>> Bestseller</label><label><input type="checkbox" name="isNewArrival" <%= product?.isNewArrival?'checked':'' %>> New arrival</label></div><button class="admin-button" type="submit">Save product</button></section>
</form><%- include('partials/footer') %>