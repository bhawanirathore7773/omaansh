<%- include('partials/header', {title:'Enquiries | OSIRA Admin', user}) %>
<div class="admin-heading"><div><p class="admin-kicker">LEADS</p><h1>Enquiries</h1><p>Review requirements, contact details and sales-stage notes.</p></div></div>
<div class="admin-filter-bar">
<a class="<%= !status ? 'active' : '' %>" href="/admin/enquiries">All</a><a class="<%= status==='new' ? 'active' : '' %>" href="/admin/enquiries?status=new">New</a><a class="<%= status==='contacted' ? 'active' : '' %>" href="/admin/enquiries?status=contacted">Contacted</a><a class="<%= status==='quoted' ? 'active' : '' %>" href="/admin/enquiries?status=quoted">Quoted</a><a class="<%= status==='won' ? 'active' : '' %>" href="/admin/enquiries?status=won">Won</a><a class="<%= status==='lost' ? 'active' : '' %>" href="/admin/enquiries?status=lost">Lost</a><a class="<%= status==='closed' ? 'active' : '' %>" href="/admin/enquiries?status=closed">Closed</a>
</div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Lead</th><th>Requirement</th><th>Product</th><th>Received</th><th>Pipeline</th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="5" class="admin-empty">No enquiries in this stage.</td></tr><% } %>
<% rows.forEach(row => { %><tr>
<td><strong><%= row.name %></strong><small><a href="tel:<%= row.phone %>"><%= row.phone %></a></small><% if(row.email){ %><small><a href="mailto:<%= row.email %>"><%= row.email %></a></small><% } %><small><%= row.city %></small></td>
<td class="requirement-cell"><%= row.message %></td><td><%= row.product?.name || 'General enquiry' %></td><td><%= new Date(row.createdAt).toLocaleString('en-IN') %></td>
<td><form method="post" action="/admin/enquiries/<%= row.id %>/status" class="status-form"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><select name="status"><% ['new','contacted','quoted','won','lost','closed'].forEach(s => { %><option value="<%= s %>" <%= row.status===s?'selected':'' %>><%= s %></option><% }) %></select><input name="notes" value="<%= row.notes || '' %>" placeholder="Follow-up note"><button type="submit">Save</button></form></td>
</tr><% }) %></tbody></table></div>
<%- include('partials/footer') %>