<%- include('partials/header', {title:(category?'Edit':'Add')+' Collection | OSIRA Admin', user}) %><div class="admin-heading"><div><p class="admin-kicker">STRUCTURE</p><h1><%= category?'Edit collection':'Add collection' %></h1></div></div><form method="post" action="/admin/categories/save" class="editor-card single-editor"><input type="hidden" name="csrfToken" value="<%= (typeof csrfToken!=='undefined'&&csrfToken)||'' %>"><% if(category){ %><input type="hidden" name="id" value="<%= category.id %>"><% } %><label>Name<input name="name" required value="<%= category?.name||'' %>"></label><label>Slug<input name="slug" required value="<%= category?.slug||'' %>"></label><label>Description<textarea name="description" rows="6"><%= category?.description||'' %></textarea></label><div class="field-grid"><label>H1 heading<input name="h1Heading" value="<%= category?.h1Heading||'' %>"></label><label>Display order<input type="number" name="displayOrder" value="<%= category?.displayOrder||0 %>"></label><label>Image URL<input name="image" value="<%= category?.image||'' %>"></label><label>Static image path<input name="staticImagePath" value="<%= category?.staticImagePath||'' %>"></label><label>Meta title<input name="metaTitle" maxlength="70" value="<%= category?.metaTitle||'' %>"></label><label>Meta description<input name="metaDescription" maxlength="160" value="<%= category?.metaDescription||'' %>"></label></div><label>SEO content<textarea name="seoContent" rows="8"><%= category?.seoContent||'' %></textarea></label><label>Meta keywords<input name="metaKeywords" value="<%= category?.metaKeywords||'' %>"></label><label><input type="checkbox" name="isFeatured" <%= category?.isFeatured?'checked':'' %>> Featured collection</label><button class="admin-button" type="submit">Save collection</button></form><%- include('partials/footer') %>