<%- include('partials/header') %>
<main class="category-page">
  <section class="section category-detail-hero-v2">
    <div class="breadcrumbs"><a href="/categories">Collections</a><span>›</span><%= category.name %></div>
    <div class="category-detail-copy"><span class="kicker">OSIRA COLLECTION</span><h1><%= category.h1Heading || category.name + ' Wall Clocks' %></h1><p><%= category.description || 'Explore wall clocks designed for practical sourcing and business orders.' %></p><div class="actions"><a class="btn primary" href="/#enquiry">Request a quotation</a><a class="btn secondary" href="/products">View all wall clocks</a></div></div>
    <div class="category-stats"><div><strong><%= category.products.length %></strong><span>active products shown</span></div><div><strong>Business</strong><span>wholesale & custom support</span></div><div><strong>OSIRA</strong><span>Jaipur-based supply</span></div></div>
  </section>
  <section class="section category-products-v2">
    <div class="section-head"><div><span class="kicker">PRODUCT RANGE</span><h2>Available products in <%= category.name %></h2></div><span class="muted-small"><%= category.products.length %> products</span></div>
    <% if(category.products.length){ %><div class="product-grid category-product-grid"><% category.products.forEach(product=>{ %>
      <a class="product-card" href="/products/<%= product.slug %>"><div class="product-media"><% if(product.image){ %><img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy" width="800" height="600"><% }else{ %><div class="placeholder">OSIRA</div><% } %></div><div class="product-body"><span><%= category.name %></span><h2><%= product.name %></h2><p><%= product.shortDescription || '' %></p><strong><%= product.price ? 'From ₹'+Number(product.price).toLocaleString('en-IN') : 'Request current price' %></strong></div></a>
    <% }) %></div><% }else{ %><div class="empty-state"><h2>Products are being added to this collection.</h2><p>Tell us the quantity, preferred style and delivery city and we can help identify the right option.</p><a class="btn primary" href="/#enquiry">Send requirement</a></div><% } %>
  </section>
  <% if(category.seoContent){ %><section class="section category-seo-copy"><span class="kicker">ABOUT THIS COLLECTION</span><div class="rich-copy"><%- category.seoContent %></div></section><% } %>
  <section class="section category-cta"><div><span class="kicker">READY TO SOURCE?</span><h2>Tell OSIRA what you need.</h2></div><a class="btn primary" href="/#enquiry">Start an enquiry →</a></section>
</main>
<%- include('partials/footer', { site }) %>