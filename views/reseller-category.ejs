<%- include('partials/header') %>
<main class="reseller-page">
<section class="section reseller-category-hero"><a class="reseller-back-link" href="/reseller">← All components</a><span class="reseller-eyebrow">OSIRA COMPONENT LIBRARY</span><h1><%= categoryTitle %></h1><p>Compare component types and fitment notes. Open any card for detailed specifications and ask us to confirm current wholesale availability.</p><div class="reseller-category-filters"><span>Product-style cards</span><span>Detailed specifications</span><span>Wholesale enquiry</span></div></section>
<section class="section reseller-category-products"><div class="reseller-section-head"><div><span class="reseller-eyebrow">COMPARE OPTIONS</span><h2><%= materials.length %> <%= categoryTitle.toLowerCase() %> options in the guide</h2><p>Featured and recommended options appear first. Tags are guidance only; confirm the exact model before ordering.</p></div></div>
<div class="reseller-material-grid"><% materials.forEach(material=>{const sizes=Array.isArray(material.sizes)?material.sizes:[];const colors=Array.isArray(material.colors)?material.colors:[];const styles=Array.isArray(material.styles)?material.styles:[];%>
<a class="reseller-material-card" href="/reseller/materials/<%= material.slug %>"><div class="reseller-material-photo"><img src="<%= material.image || 'https://images.unsplash.com/photo-1563861826100-9cb868fdbe1c?auto=format&fit=crop&w=900&q=80' %>" alt="<%= material.name %>" loading="lazy" width="600" height="600"><span class="reseller-material-type"><%= material.componentType %></span><% if(material.isFeatured){ %><span class="reseller-badge reseller-badge-featured">FEATURED</span><% } else if(material.isRecommended){ %><span class="reseller-badge reseller-badge-recommended">RECOMMENDED</span><% } %></div><div class="reseller-material-card-body"><h3><%= material.name %></h3><p><%= material.shortDescription %></p><div class="reseller-tag-list"><% sizes.slice(0,2).forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }); colors.slice(0,2).forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }); styles.slice(0,1).forEach(x=>{ %><span class="reseller-tag"><%= x %></span><% }); %></div><span class="reseller-card-link">View product details <span aria-hidden="true">↗</span></span></div></a>
<% }); %></div>
<% if(!materials.length){ %><div class="reseller-empty"><h2>More options are being added.</h2><p>Contact us to ask about other <%= categoryTitle.toLowerCase() %> types, dimensions and wholesale quantities.</p><a class="reseller-btn reseller-btn-primary" href="https://wa.me/<%= (site?.whatsappNumber || '919509912556').replace(/[^0-9]/g,'') %>?text=<%= encodeURIComponent((settings.whatsappIntro||'Hello OSIRA')+'\nPlease share available '+categoryTitle+' types, specifications and wholesale pricing.') %>" target="_blank" rel="noopener noreferrer">Ask about <%= categoryTitle %> ↗</a></div><% } %>
</section>
<section class="section"><div class="reseller-final-cta"><div><h2>Need help choosing the right <%= categoryTitle.toLowerCase() %>?</h2><p>Share your target clock size, design and approximate quantity. Ask us to confirm the right fitment, available options, MOQ and pricing.</p></div><a class="reseller-btn reseller-btn-primary" href="https://wa.me/<%= (site?.whatsappNumber || '919509912556').replace(/[^0-9]/g,'') %>?text=<%= encodeURIComponent((settings.whatsappIntro||'Hello OSIRA')+'\nI am enquiring about '+categoryTitle+' options.') %>" target="_blank" rel="noopener noreferrer">Enquire on WhatsApp ↗</a></div></section>
</main><%- include('partials/footer', { site }) %>